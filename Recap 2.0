          .mufy-mask-picker-item .mufy-mask-current{color:#888;font-size:11px;flex:none;}
          .mufy-mask-picker-empty,.mufy-mask-picker-loading{padding:24px 16px;text-align:center;color:#888;font-size:12px}
          .mufy-mask-tbtn{background:transparent;border:1px solid #333;color:#aaa;padding:6px 12px;border-radius:8px;font-size:12px;cursor:pointer}
          .mufy-mask-tbtn:hover{color:#fff;border-color:#666}
