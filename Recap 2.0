// ==UserScript==
// @name         Mufy Recap
// @namespace    http://tampermonkey.net/
// @version      28.1
// @description  你想到的想不到的这里可能有也可能没有
// @author       Nullpointer与Deepseek与Chatgpt 排名分先后 哼哼
// @license      MIT
// @match        https://*.mufy.ai/*
// @grant        none
// @run-at       document-start
// ==/UserScript==

(function () {
    'use strict';

    const sleep = ms => new Promise(r => setTimeout(r, ms));
    const API_BASE = 'https://chat.mufy.ai';
    const STORAGE_MY_ID_KEY = 'mufy_my_user_id_auto';
    const CACHE_DATA_KEY = 'mufy_annual_report_cache_v25';
const MASK_LIBRARY_KEY = 'mufy_mask_library_v1';
const TAG_RULES_KEY = 'mufy_tag_folder_rules_v1';
    const MAX_RENDER_COUNT = 1000;

    let capturedAuth = '';
    let autoDetectedId = '';

    function isMyProfileUrl(url) {
        try {
            const u = new URL(url, location.origin);
            return ['/api/users/profile', '/api/user/profile', '/api/user/info', '/api/users/me'].includes(u.pathname);
        } catch (e) { return false; }
    }

    (function installAuthCapture() {
        try {
            const XHR = window.XMLHttpRequest;
            if (XHR && !XHR.prototype.__mufyHook) {
                XHR.prototype.__mufyHook = true;
                const origOpen = XHR.prototype.open;
                const origSetHeader = XHR.prototype.setRequestHeader;
                const origSend = XHR.prototype.send;
                XHR.prototype.open = function (method, url, ...rest) {
                    this.__mufyUrl = String(url || '');
                    return origOpen.call(this, method, url, ...rest);
                };
                XHR.prototype.setRequestHeader = function (name, value) {
                    if (/^authorization$/i.test(String(name)) && /(?:^|\/)api(?:\/|$)/i.test(this.__mufyUrl || '')) {
                        const v = String(value || '');
                        if (/^Bearer\s+\S+/i.test(v)) capturedAuth = v;
                    }
                    return origSetHeader.call(this, name, value);
                };
                XHR.prototype.send = function (...args) {
                    this.addEventListener('load', function() {
                        try {
                            if (this.__mufyUrl && isMyProfileUrl(this.__mufyUrl)) {
                                const res = JSON.parse(this.responseText);
                                const d = res?.data?.data || res?.data || res;
                                if (d && (d.id || d.userId) && (d.username || d.email || d.nickname || d.nickName)) autoDetectedId = String(d.id || d.userId);
                            }
                        } catch(e) {}
                    });
                    return origSend.apply(this, args);
                };
            }
        } catch (_) {}
        try {
            const origFetch = window.fetch;
            if (typeof origFetch === 'function' && !origFetch.__mufyHook) {
                const wrapped = function (input, init) {
                    const url = typeof input === 'string' ? input : (input && input.url) || '';
                    try {
                        if (/(?:^|\/)api(?:\/|$)/i.test(url)) {
                            const headers = (init && init.headers) || (input && input.headers);
                            if (headers instanceof Headers) {
                                const auth = headers.get('Authorization') || headers.get('authorization');
                                if (auth) capturedAuth = auth;
                            } else if (headers && typeof headers === 'object' && !Array.isArray(headers)) {
                                for (const k of Object.keys(headers)) if (/^authorization$/i.test(k)) capturedAuth = headers[k];
                            }
                        }
                    } catch (_) {}
                    const p = origFetch.apply(this, arguments);
                    if (isMyProfileUrl(url)) {
                        try {
                            p.then(res => {
                                const clone = res.clone();
                                clone.json().then(data => {
                                    const d = data?.data?.data || data?.data || data;
                                    if (d && (d.id || d.userId) && (d.username || d.email || d.nickname || d.nickName)) autoDetectedId = String(d.id || d.userId);
                                }).catch(()=>{});
                            }).catch(()=>{});
                        } catch(e) {}
                    }
                    return p;
                };
                wrapped.__mufyHook = true;
                window.fetch = wrapped;
            }
        } catch (_) {}
    })();

        function getAuthorization() {
        // ★ 修复：优先使用当前网页真实的 Token，防止被其他号的查询污染
        const local = localStorage.getItem('mufy-token') || localStorage.getItem('token') || localStorage.getItem('mufy_token');
        if (local && local !== 'null' && local !== 'undefined') {
            return /^Bearer\s+/i.test(local) ? local : `Bearer ${local}`;
        }
        if (capturedAuth && capturedAuth !== 'Bearer null' && capturedAuth !== 'Bearer undefined') {
            return capturedAuth;
        }
        return '';
}
    async function getMyUserId(onProgress) {
        let tokenId = '';
        const auth = getAuthorization();
        const token = auth.replace(/^Bearer\s+/i, '');
        if (token && token.split('.').length === 3) {
            try {
                const base64Url = token.split('.')[1];
                const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                const jsonPayload = decodeURIComponent(atob(base64).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join(''));
                const payload = JSON.parse(jsonPayload);
                tokenId = String(payload.userId || payload.id || payload.uid || payload.user_id || payload.sub || '');
            } catch (e) {}
        }
        const savedId = localStorage.getItem(STORAGE_MY_ID_KEY);
        if (tokenId && savedId && tokenId !== savedId) {
            localStorage.removeItem(STORAGE_MY_ID_KEY);
            localStorage.removeItem(CACHE_DATA_KEY);
            return tokenId;
        }
        if (tokenId) return tokenId;
        if (savedId) return savedId;
        if (autoDetectedId) return autoDetectedId;
        const scanStorage = (storage) => {
            for (let i = 0; i < storage.length; i++) {
                const key = storage.key(i);
                const val = storage.getItem(key);
                if (!val) continue;
                if (val.includes('userId') || val.includes('user_id')) {
                    try {
                        const obj = JSON.parse(val);
                        const id = obj.userId || obj.user_id || obj.id || (obj.user && obj.user.id) || (obj.state && obj.state.user && obj.state.user.id);
                        if (id && String(id).length > 20 && String(id).includes('-')) return String(id);
                    } catch(e) {}
                }
            }
            return null;
        };
        const localId = scanStorage(localStorage) || scanStorage(sessionStorage);
        if (localId) return localId;
        onProgress?.('正在询问服务器获取你的ID...');
        const apis = ['/api/users/profile', '/api/user/info', '/api/users/me', '/api/user/profile'];
        for (const api of apis) {
            try {
                const res = await fetch(`${API_BASE}${api}`, { headers: { 'Authorization': getAuthorization() }, credentials: 'include' });
                if (res.ok) {
                    const data = await res.json();
                    const d = data?.data?.data || data?.data || data;
                    if (d && (d.id || d.userId)) return String(d.id || d.userId);
                }
            } catch (e) {}
        }
        return '';
    }

    async function mufyPost(url, data, retry = 2) {
        const headers = { 'Accept': 'application/json, text/plain, */*', 'Content-Type': 'application/json', 'Origin': 'https://chat.mufy.ai', 'Referer': 'https://chat.mufy.ai/' };
        const auth = getAuthorization();
        if (auth) headers.Authorization = auth;
        for (let i = 0; i < retry; i++) {
            try {
                const res = await fetch(url, { method: 'POST', headers, body: JSON.stringify(data), credentials: 'include' });
                if (res.status === 429) { await sleep(3000); continue; }
                let resData = null;
                try { resData = await res.json(); } catch(e) {}
                if (resData && resData.error === 'share_link_expired') {
                    const err = new Error('share_link_expired');
                    err.isExpired = true;
                    throw err;
                }
                if (!res.ok) {
                    const err = new Error(`HTTP ${res.status}${resData?.reason ? ' · ' + resData.reason : ''}`);
                    err.status = res.status;
                    err.resData = resData;
                    throw err;
                }
                return resData;
            } catch (e) {
                if (e.isExpired) throw e;
                if (i === retry - 1) {
                    if (e.status) throw e;
                    throw new Error(e.name === 'TypeError' ? '网络被拦截/跨域' : e.message);
                }
                await sleep(1000);
            }
        }
    }

    async function mufyPut(url, data, retry = 2) {
        const headers = { 'Accept': 'application/json, text/plain, */*', 'Content-Type': 'application/json', 'Origin': 'https://chat.mufy.ai', 'Referer': 'https://chat.mufy.ai/' };
        const auth = getAuthorization();
        if (auth) headers.Authorization = auth;
        for (let i = 0; i < retry; i++) {
            try {
                const res = await fetch(url, { method: 'PUT', headers, body: JSON.stringify(data), credentials: 'include' });
                if (res.status === 429) { await sleep(3000); continue; }
                let resData = null;
                try { resData = await res.json(); } catch(e) {}
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                return resData;
            } catch (e) {
                if (i === retry - 1) throw new Error(e.name === 'TypeError' ? '网络被拦截/跨域' : e.message);
                await sleep(1000);
            }
        }
    }

    async function mufyGet(url, retry = 2) {
        const headers = { 'Accept': 'application/json', 'Referer': 'https://chat.mufy.ai/' };
        const auth = getAuthorization();
        if (auth) headers.Authorization = auth;
        for (let i = 0; i < retry; i++) {
            try {
                const res = await fetch(url, { headers, credentials: 'include' });
                if (res.status === 429) { await sleep(3000); continue; }
                let resData = null;
                try { resData = await res.json(); } catch(e) {}
                if (resData && resData.error === 'share_link_expired') {
                    const err = new Error('share_link_expired');
                    err.isExpired = true;
                    throw err;
                }
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                return resData;
            } catch (e) {
                if (e.isExpired) throw e;
                if (i === retry - 1) throw new Error(e.name === 'TypeError' ? '网络被拦截/跨域' : e.message);
                await sleep(1000);
            }
        }
    }

    function pick(obj, ...paths) {
        for (const path of paths) {
            const v = path.split('.').reduce((o, key) => (o == null ? undefined : o[key]), obj);
            if (v != null && v !== '') return v;
        }
        return undefined;
    }
const state = {
    accounts: [],
    loading: false, roles: [], authors: [], activeTab: 'role', myUserId: '',
    searchQuery: '', searchParsed: null, isScanning: false, expandedAuthors: new Set(),
    collectionLog: [], maskBindings: {}, collectionFilter: 'all', collectionMode: 'author', folderLog: [],
    maskLibrary: { items: [] },
    harvest: {
            running: false,
            status: '准备就绪',
            current: 0,
            total: 0,
            successFollow: [],
            successMsg: [],
            lastStartIdx: 1,
            lastEndIdx: 10
        }
    };
    let masksCache = null, masksCacheTime = 0;

    function saveCache() {
        localStorage.setItem(CACHE_DATA_KEY, JSON.stringify({
            roles: state.roles, authors: state.authors, myUserId: state.myUserId,
            collectionLog: state.collectionLog, maskBindings: state.maskBindings,
            folderLog: state.folderLog, time: new Date().toLocaleString('zh-CN')
        }));
    }
    function loadCache() {
        try {
            const data = JSON.parse(localStorage.getItem(CACHE_DATA_KEY) || 'null');
            if (data && data.roles && data.roles.length > 0) {
                if (data.myUserId && state.myUserId && data.myUserId !== state.myUserId) return null;
                state.roles = data.roles; state.authors = data.authors;
                state.myUserId = data.myUserId;
                state.collectionLog = data.collectionLog || [];
                state.maskBindings = data.maskBindings || {};
                state.folderLog = data.folderLog || [];
                return data.time;
            }
        } catch(e) {}
        return null;
    }

    async function fetchAllCharacters(onProgress) {
        const roleMap = new Map();
        for (const isFollowed of [false, true]) {
            let page = 1, hasNext = true;
            while (hasNext && page <= 100) {
                onProgress?.(`读取列表第 ${page} 页...`);
                let res;
                try { res = await mufyGet(`${API_BASE}/api/characters/query_session?pageNum=${page}&pageSize=20&isFollowed=${isFollowed}`); }
                catch (e) { throw new Error(`抓取列表失败: ${e.message}`); }
                const rows = Array.isArray(res?.data?.data) ? res.data.data : [];
                rows.forEach(item => {
                    const cid = pick(item, 'characterId', 'id');
                    if (!cid) return;
                    const charObj = item.character || item.characterInfo || {};
                    const authorObj = item.author || item.creator || item.user || charObj.author || charObj.creator || {};
                    const aId = pick(item, 'authorId', 'creatorId', 'userId', 'ownerId') || pick(charObj, 'authorId', 'creatorId', 'userId') || pick(authorObj, 'id', 'userId') || '';
                    const realFollowed = item.isFollowed != null ? Boolean(item.isFollowed) : isFollowed;
                    roleMap.set(cid, {
    characterId: cid,
    name: pick(item, 'name', 'characterName', 'title') || pick(charObj, 'name') || '未命名',
    authorId: aId,
    authorName: pick(item, 'authorName', 'creatorName') || pick(authorObj, 'name', 'username', 'nickname') || '',
    avatarUrl: item.avatarUrl || '',
    tags: Array.isArray(item.tags) ? item.tags : [],              // ★ 新增
    rounds: 0, hasCommented: false, isScanning: false, hasScanned: false, isExpired: false,
    isFollowed: realFollowed, lastSessionId: item.lastSessionId || null
});
                });
                hasNext = Boolean(res?.data?.hasNext) && rows.length > 0;
                page++;
                await sleep(150);
            }
        }
        return [...roleMap.values()];
    }

    function isSameId(id1, id2) {
        if (!id1 || !id2) return false;
        const clean = (str) => String(str).replace(/[-\s]/g, '').toLowerCase();
        return clean(id1) === clean(id2);
    }

    function walkCommentTree(list, visitor, seen = new Set()) {
        if (!Array.isArray(list)) return;
        for (const comment of list) {
            if (!comment || typeof comment !== 'object' || seen.has(comment)) continue;
            seen.add(comment);
            visitor(comment);
            const children = comment.subComments || comment.sub_comments || comment.replies || comment.children;
            if (Array.isArray(children)) walkCommentTree(children, visitor, seen);
        }
    }

    async function fetchMyRoundsFromComments(characterId, myUserId) {
        if (!myUserId) return { rounds: 0, hasCommented: false, isExpired: false };
        let myRounds = 0, hasCommented = false, isExpired = false;
        const seenCommentIds = new Set();
        const processComment = (comment) => {
            const commentId = pick(comment, 'id', 'commentId');
            if (commentId && seenCommentIds.has(String(commentId))) return;
            if (commentId) seenCommentIds.add(String(commentId));
            const commenterId = pick(comment, 'commentatorId', 'userId', 'authorId', 'commentator.id', 'user.id', 'author.id');
            if (!isSameId(commenterId, myUserId)) return;
            hasCommented = true;
            const value = Number(pick(comment, 'interactionRounds', 'rounds') || 0);
            if (Number.isFinite(value) && value > myRounds) myRounds = value;
        };
        const fetchMyReplies = async (parentComment) => {
            if (!parentComment?.id) return;
            try {
                const rRes = await mufyGet(`${API_BASE}/api/comments/list?parentId=${parentComment.id}&pageNum=1&pageSize=50`, 1);
                if (rRes?.data) {
                    const rList = Array.isArray(rRes.data) ? rRes.data : (rRes.data.data || []);
                    walkCommentTree(rList, processComment);
                }
            } catch (e) {}
        };
        const PAGE_SIZE = 20;
        let page = 1, hasNext = true;
        while (hasNext && page <= 15 && !isExpired) {
            let res;
            try { res = await mufyPost(`${API_BASE}/api/comments/list`, { characterId, sortBy: "time", pageNum: page, pageSize: PAGE_SIZE }, 1); }
            catch (e) { if (e.isExpired) isExpired = true; break; }
            if (!res || res.code !== 200) break;
            const comments = Array.isArray(res?.data?.data) ? res.data.data : [];
            if (comments.length === 0) break;
            walkCommentTree(comments, processComment);
            if (myRounds > 0) return { rounds: myRounds, hasCommented: true, isExpired: false };
            if (hasCommented) {
                const mine = comments.find(c => isSameId(pick(c, 'commentatorId', 'userId'), myUserId));
                if (mine) { await fetchMyReplies(mine); if (myRounds > 0) return { rounds: myRounds, hasCommented: true, isExpired: false }; }
            }
            const nf = res?.data?.hasNext;
            hasNext = nf != null ? Boolean(nf) : (comments.length >= PAGE_SIZE);
            page++;
            await sleep(180);
        }
        page = 1; hasNext = true;
        while (hasNext && page <= 40 && !isExpired) {
            let res;
            try { res = await mufyPost(`${API_BASE}/api/comments/list`, { characterId, sortBy: "heat", pageNum: page, pageSize: PAGE_SIZE }); }
            catch (e) { if (e.isExpired) isExpired = true; break; }
            const comments = Array.isArray(res?.data?.data) ? res.data.data : [];
            if (comments.length === 0) break;
            walkCommentTree(comments, processComment);
            if (myRounds > 0) break;
            if (hasCommented) {
                const mine = comments.find(c => isSameId(pick(c, 'commentatorId', 'userId'), myUserId));
                if (mine) { await fetchMyReplies(mine); if (myRounds > 0) break; }
            }
            const nf = res?.data?.hasNext;
            hasNext = nf != null ? Boolean(nf) : (comments.length >= PAGE_SIZE);
            page++;
            await sleep(200);
        }
        return { rounds: myRounds, hasCommented, isExpired };
    }

    async function streamScanRoles(roles, myUserId, onProgress, onItemUpdate) {
        if (!myUserId) return;
        const CONCURRENCY = 2;
        let index = 0, completedCount = 0;
        async function worker() {
            while (index < roles.length) {
                const currentIndex = index++;
                const role = roles[currentIndex];
                role.isScanning = true;
                onItemUpdate();
                const result = await fetchMyRoundsFromComments(role.characterId, myUserId);
                role.rounds = result.rounds;
                role.hasCommented = result.hasCommented;
                if (result.isExpired) role.isExpired = true;
                role.isScanning = false;
                role.hasScanned = true;
                completedCount++;
                onProgress(completedCount, roles.length);
                onItemUpdate();
                await sleep(150);
            }
        }
        await Promise.all(Array.from({ length: CONCURRENCY }, worker));
    }

    async function streamScanAuthors(authors, onProgress, onItemUpdate) {
        const CONCURRENCY = 2;
        let index = 0, completedCount = 0;
        async function worker() {
            while (index < authors.length) {
                const currentIndex = index++;
                const author = authors[currentIndex];
                author.isScanning = true;
                onItemUpdate();
                if (author.id !== 'unknown') {
                    try {
                        const res = await mufyGet(`${API_BASE}/api/users/profiles?userId=${encodeURIComponent(author.id)}`);
                        if (res.code === 200) {
                            const d = res.data?.data || res.data || res;
                            const newName = pick(d, 'username', 'nickname', 'name');
                            if (newName) {
                                author.name = newName;
                                state.roles.forEach(r => { if (r.authorId === author.id) r.authorName = newName; });
                            }
                            author.avatarUrl = pick(d, 'avatarUrl', 'avatar', 'commentatorAvatarUrl') || author.avatarUrl;
                            author.totalRounds = Number(pick(d, 'totalChatRounds') || 0);
                            author.cards = Number(pick(d, 'createdCharacterCount') || 0);
                            author.level = Number(pick(d, 'creatorLevel') || 0);
                        }
                    } catch(e) { console.warn(e); }
                }
                author.hasScanned = true;
                author.isScanning = false;
                completedCount++;
                onProgress(completedCount, authors.length);
                onItemUpdate();
                await sleep(150);
            }
        }
        await Promise.all(Array.from({ length: CONCURRENCY }, worker));
    }

    // ============ 收藏 / 面具 / 收藏夹 ============
    async function followCharacter(cid, wantFollow) {
        try {
            const r = await mufyPost(`${API_BASE}/api/characters/follow`, { characterId: cid, isFavorite: !!wantFollow }, 2);
            return { ok: r && r.code === 200, raw: r };
        } catch (e) { return { ok: false, error: e.message }; }
    }

    // ============ 面具库 ============
    function loadMaskLibrary() {
        try {
            const data = JSON.parse(localStorage.getItem(MASK_LIBRARY_KEY) || 'null');
            if (data && Array.isArray(data.items)) return data;
        } catch (e) {}
        return { items: [] };
    }
    function saveMaskLibrary() {
        try { localStorage.setItem(MASK_LIBRARY_KEY, JSON.stringify(state.maskLibrary)); } catch (e) {}
    }
    function genLocalId() {
        return 'lm_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 8);
    }

    async function syncMaskLibraryFromOfficial() {
        const res = await mufyPost(`${API_BASE}/api/masks/query`, { page: 1, pageSize: 100 }, 2);
        if (res?.code !== 200 || !Array.isArray(res.data?.data)) throw new Error(res?.reason || '获取官方面具失败');
        const officialMasks = res.data.data;
        const lib = state.maskLibrary;
        const officialIds = new Set(officialMasks.map(m => m.maskId));

        officialMasks.forEach(om => {
            let item = lib.items.find(i => i.officialMaskId === om.maskId);
            if (item) {
                item.maskName = om.maskName || item.maskName;
                item.gender = om.gender || '';
                item.description = om.description || '';
                item.favorite = om.favorite || '';
                item.command = om.command || '';
                item.remark = om.remark || '';
            } else {
                lib.items.push({
                    localId: genLocalId(),
                    maskName: om.maskName || `面具#${om.maskId}`,
                    gender: om.gender || '',
                    description: om.description || '',
                    favorite: om.favorite || '',
                    command: om.command || '',
                    remark: om.remark || '',
                    officialMaskId: om.maskId,
                    lastUsedAt: Date.now()
                });
            }
        });

        lib.items.forEach(it => {
            if (it.officialMaskId && !officialIds.has(it.officialMaskId)) {
                it.officialMaskId = null;
            }
        });

        Object.keys(state.maskBindings || {}).forEach(cid => {
            const b = state.maskBindings[cid];
            if (b && !b.localId && b.maskId) {
                const it = lib.items.find(i => i.officialMaskId === Number(b.maskId));
                if (it) b.localId = it.localId;
            }
        });

        saveMaskLibrary();
        saveCache();
        return lib.items;
    }

    async function activateMaskToOfficial(localId, victimMaskId) {
        const item = state.maskLibrary.items.find(i => i.localId === localId);
        if (!item) throw new Error('本地面具不存在');
        if (item.officialMaskId) return item.officialMaskId;

        const payload = {
            maskName: item.maskName,
            gender: item.gender || '',
            description: item.description || '',
            favorite: item.favorite || '',
            command: item.command || '',
            remark: item.remark || ''
        };

        if (victimMaskId) {
            const res = await mufyPost(`${API_BASE}/api/masks/update`, { maskId: Number(victimMaskId), ...payload }, 2);
            if (!res || res.code !== 200) throw new Error(res?.reason || '覆盖槽位失败');
            const victim = state.maskLibrary.items.find(i => i.officialMaskId === Number(victimMaskId));
            if (victim) victim.officialMaskId = null;
            item.officialMaskId = Number(victimMaskId);
            item.lastUsedAt = Date.now();
            saveMaskLibrary();
            return item.officialMaskId;
        }

        let res = null;
        let caughtErr = null;
        try {
            res = await mufyPost(`${API_BASE}/api/masks/create`, payload, 1);
        } catch (e) {
            caughtErr = e;
        }

        if (caughtErr) {
            if (caughtErr.name === 'TypeError' || (caughtErr.message || '').includes('网络被拦截')) {
                throw caughtErr;
            }
            const err = new Error(caughtErr.message || '创建失败，可能槽位已满');
            err.slotFull = true;
            err.resData = caughtErr.resData;
            throw err;
        }

        if (!res || res.code !== 200 || !res.data?.maskId) {
            const err = new Error(res?.reason || '创建失败（可能槽位已满）');
            err.slotFull = true;
            err.resData = res;
            throw err;
        }

        item.officialMaskId = res.data.maskId;
        item.lastUsedAt = Date.now();
        saveMaskLibrary();
        return item.officialMaskId;
    }

    async function deleteLibraryMask(localId) {
        const item = state.maskLibrary.items.find(i => i.localId === localId);
        if (!item) return;
        if (item.officialMaskId) {
            const res = await mufyPost(`${API_BASE}/api/masks/delete`, { maskId: item.officialMaskId }, 2);
            if (!res || res.code !== 200) throw new Error('删除官方槽位失败');
        }
        state.maskLibrary.items = state.maskLibrary.items.filter(i => i.localId !== localId);
        Object.keys(state.maskBindings || {}).forEach(cid => {
            if (state.maskBindings[cid]?.localId === localId) delete state.maskBindings[cid];
        });
        saveMaskLibrary();
        saveCache();
    }

    async function updateLibraryMask(localId, data) {
        const item = state.maskLibrary.items.find(i => i.localId === localId);
        if (!item) throw new Error('不存在');
        Object.assign(item, data);
        if (item.officialMaskId) {
            const res = await mufyPost(`${API_BASE}/api/masks/update`, {
                maskId: item.officialMaskId,
                maskName: item.maskName,
                gender: item.gender || '',
                description: item.description || '',
                favorite: item.favorite || '',
                command: item.command || '',
                remark: item.remark || ''
            }, 2);
            if (!res || res.code !== 200) throw new Error(res?.reason || '同步官方失败');
        }
        saveMaskLibrary();
    }

    async function promptActivateMask(item, onDone) {
        try {
            await activateMaskToOfficial(item.localId, null);
            onDone?.();
            return true;
        } catch (e) {
            if (!e.slotFull) throw e;
        }

        const officialMasks = await mufyPost(`${API_BASE}/api/masks/query`, { page: 1, pageSize: 50 }).then(r => r?.data?.data || []).catch(() => []);
        if (!officialMasks.length) throw new Error('槽位已满且无法获取列表');

        return new Promise(resolve => {
            const overlay = document.createElement('div');
            overlay.className = 'mufy-mask-overlay';
            overlay.innerHTML = `
              <div class="mufy-mask-picker" style="width:420px;">
                <div class="mufy-mask-picker-header">
                  <div class="mufy-mask-picker-title">槽位已满，选择要替换的槽位</div>
                  <button class="mufy-mask-picker-close">×</button>
                </div>
                <div style="padding:8px 16px;color:#888;font-size:11px;border-bottom:1px solid #222;">
                  被替换的面具会保留在本地库，随时可再换回来。
                </div>
                <div class="mufy-mask-picker-list">
                  ${officialMasks.map(m => `
                    <div class="mufy-mask-picker-item" data-mask-id="${m.maskId}">
                      <div>
                        <div class="mufy-mask-name">${esc(m.maskName)}</div>
                        <div class="mufy-mask-gender">${esc(m.gender || '')}${m.remark ? ' · ' + esc(m.remark) : ''}</div>
                      </div>
                      <span style="color:#666;font-size:11px;">替换</span>
                    </div>`).join('')}
                </div>
              </div>`;
            document.body.appendChild(overlay);
            const close = (v) => { overlay.remove(); resolve(v); };
            overlay.querySelector('.mufy-mask-picker-close').addEventListener('click', () => close(false));
            overlay.addEventListener('click', e => { if (e.target === overlay) close(false); });
            overlay.querySelectorAll('.mufy-mask-picker-item').forEach(el => {
                el.addEventListener('click', async () => {
                    el.style.opacity = '.5'; el.style.pointerEvents = 'none';
                    try {
                        await activateMaskToOfficial(item.localId, Number(el.getAttribute('data-mask-id')));
                        onDone?.();
                        close(true);
                    } catch (err) {
                        alert('替换失败：' + err.message);
                        close(false);
                    }
                });
            });
        });
    }

    function showMaskEditDialog(item, onDone) {
        const isNew = !item;
        const overlay = document.createElement('div');
        overlay.className = 'mufy-mask-overlay';
        overlay.innerHTML = `
          <div class="mufy-mask-picker" style="width:480px;">
            <div class="mufy-mask-picker-header">
              <div class="mufy-mask-picker-title">${isNew ? '新增面具' : '编辑面具'}</div>
              <button class="mufy-mask-picker-close">×</button>
            </div>
            <div style="padding:12px 16px;overflow-y:auto;max-height:60vh;">
              <label style="display:block;margin-bottom:8px;">
                <div style="color:#888;font-size:11px;margin-bottom:4px;">面具名 *</div>
                <input class="mufy-mask-input" data-field="maskName" value="${esc(item?.maskName || '')}">
              </label>
              <label style="display:block;margin-bottom:8px;">
                <div style="color:#888;font-size:11px;margin-bottom:4px;">性别</div>
                <input class="mufy-mask-input" data-field="gender" value="${esc(item?.gender || '')}" placeholder="男 / 女 / 其他">
              </label>
              <label style="display:block;margin-bottom:8px;">
                <div style="color:#888;font-size:11px;margin-bottom:4px;">备注</div>
                <input class="mufy-mask-input" data-field="remark" value="${esc(item?.remark || '')}">
              </label>
              <label style="display:block;margin-bottom:8px;">
                <div style="color:#888;font-size:11px;margin-bottom:4px;">描述</div>
                <textarea class="mufy-mask-input" data-field="description" rows="6" style="resize:vertical;font-family:inherit;">${esc(item?.description || '')}</textarea>
              </label>
              <label style="display:block;margin-bottom:8px;">
                <div style="color:#888;font-size:11px;margin-bottom:4px;">Favorite</div>
                <input class="mufy-mask-input" data-field="favorite" value="${esc(item?.favorite || '')}">
              </label>
              <label style="display:block;margin-bottom:8px;">
                <div style="color:#888;font-size:11px;margin-bottom:4px;">Command</div>
                <input class="mufy-mask-input" data-field="command" value="${esc(item?.command || '')}">
              </label>
            </div>
            <div style="padding:12px 16px;border-top:1px solid #222;display:flex;justify-content:flex-end;gap:8px;">
              <button class="mufy-mask-tbtn" id="mufy-mk-cancel">取消</button>
              <button class="mufy-mask-tbtn primary" id="mufy-mk-save">${isNew ? '创建' : '保存'}</button>
            </div>
          </div>`;
        document.body.appendChild(overlay);
        const close = () => overlay.remove();
        overlay.querySelector('.mufy-mask-picker-close').addEventListener('click', close);
        overlay.querySelector('#mufy-mk-cancel').addEventListener('click', close);
        overlay.addEventListener('click', e => { if (e.target === overlay) close(); });
        overlay.querySelector('#mufy-mk-save').addEventListener('click', async () => {
            const get = f => overlay.querySelector(`[data-field="${f}"]`).value;
            const data = {
                maskName: get('maskName').trim(),
                gender: get('gender').trim(),
                remark: get('remark').trim(),
                description: get('description'),
                favorite: get('favorite').trim(),
                command: get('command').trim()
            };
            if (!data.maskName) { alert('面具名不能为空'); return; }
            const saveBtn = overlay.querySelector('#mufy-mk-save');
            saveBtn.disabled = true; saveBtn.textContent = '保存中...';
            try {
                if (isNew) {
                    state.maskLibrary.items.push({
                        localId: genLocalId(), ...data, officialMaskId: null, lastUsedAt: Date.now()
                    });
                    saveMaskLibrary();
                } else {
                    await updateLibraryMask(item.localId, data);
                }
                close(); onDone?.();
            } catch (err) {
                alert('保存失败：' + err.message);
                saveBtn.disabled = false; saveBtn.textContent = isNew ? '创建' : '保存';
            }
        });
    }

    // ============ 面具切换 ============
    async function switchMask(cid, maskId, maskName, localId) {
        const r1 = await mufyPost(`${API_BASE}/api/characters/mask`, { characterId: cid, maskId: Number(maskId) }, 2);
        if (!r1 || r1.code !== 200) return false;
        const role = state.roles.find(r => isSameId(r.characterId, cid));
        if (role && role.lastSessionId) {
            try {
                const r2 = await mufyPost(`${API_BASE}/api/sessions/mask`, { maskId: Number(maskId), sessionId: role.lastSessionId }, 1);
                if (r2?.code === 200) sessionStorage.setItem(`mufy_mask_switched_${role.lastSessionId}`, String(maskId));
            } catch (e) { console.warn('[Mufy] 切当前会话面具失败:', e.message); }
        }
        state.maskBindings[cid] = { maskId: Number(maskId), maskName, localId: localId || null };
        saveCache();
        const currentRoleId = new URL(location.href).searchParams.get('roleId');
        if (currentRoleId && isSameId(currentRoleId, cid)) {
            setTimeout(() => {
                if (confirm('面具已切换，当前聊天页需要刷新才能看到新面具，立即刷新？')) location.reload();
            }, 300);
        }
        return true;
    }

    async function maybeAutoSwitchMask() {
        try {
            const roleId = new URL(location.href).searchParams.get('roleId');
            if (!roleId) return;
            const binding = state.maskBindings[roleId];
            if (!binding) return;

            let targetMaskId = binding.maskId;
            if (binding.localId) {
                const libItem = state.maskLibrary.items.find(i => i.localId === binding.localId);
                if (libItem && libItem.officialMaskId) {
                    targetMaskId = libItem.officialMaskId;
                } else {
                    console.warn(`[Mufy] 面具「${binding.maskName}」当前不在槽位，跳过自动切换`);
                    return;
                }
            }
            if (!targetMaskId) return;

            const role = state.roles.find(r => isSameId(r.characterId, roleId));
            const sessionId = role?.lastSessionId;
            if (!sessionId) {
                await mufyPost(`${API_BASE}/api/characters/mask`, { characterId: roleId, maskId: targetMaskId }, 1).catch(() => {});
                return;
            }
            const key = `mufy_mask_switched_${sessionId}`;
            if (sessionStorage.getItem(key) === String(targetMaskId)) return;
            const r = await mufyPost(`${API_BASE}/api/sessions/mask`, { maskId: targetMaskId, sessionId }, 1);
            if (r?.code === 200) {
                sessionStorage.setItem(key, String(targetMaskId));
                console.log(`%c[Mufy] 已自动为「${role.name}」切面具 -> ${binding.maskName}`, 'color:#fff');
            }
        } catch (e) { console.warn('[Mufy] 自动切面具异常:', e.message); }
    }

    // ============ 收藏夹 ============
    async function fetchAllFavoriteFolders() {
        try {
            const res = await mufyGet(`${API_BASE}/api/favorites/list?pageNum=1&pageSize=100`);
            if (res?.code === 200) {
                const d = res.data;
                if (Array.isArray(d)) return d;
                if (Array.isArray(d?.data)) return d.data;
            }
            return [];
        } catch (e) { console.warn('[Mufy] 拉收藏夹失败:', e.message); return []; }
    }

    async function createFavoriteFolder(name) {
        try {
            let res = await mufyPost(`${API_BASE}/api/favorites/`, { name, customCover: '' }, 1);
            if (res?.code === 200 && res.data?.id) return res.data.id;
            res = await mufyPost(`${API_BASE}/api/favorites/`, { name }, 1);
            if (res?.code === 200 && res.data?.id) return res.data.id;
            console.warn('[Mufy] 创建收藏夹返回无 id:', res);
            return null;
        } catch (e) {
            console.warn('[Mufy] 创建收藏夹异常:', e.message);
            return null;
        }
    }

    async function addCharactersToFolder(folderId, characterIds) {
        const successIds = [];
        const failedDetails = [];
        for (const cid of characterIds) {
            try {
                const res = await mufyPut(`${API_BASE}/api/favorites/characters`, {
                    folderId: folderId,
                    addCharacterIds: [cid]
                }, 2);
                if (res?.code === 200) {
                    successIds.push(cid);
                } else {
                    failedDetails.push({ cid, code: res?.code, reason: res?.reason, data: res?.data });
                    console.warn(`[Mufy 加角色失败] ${cid}`, res);
                }
            } catch (e) {
                failedDetails.push({ cid, error: e.message });
                console.warn(`[Mufy 加角色异常] ${cid}:`, e.message);
            }
            await sleep(500);
        }
        return { success: successIds.length > 0, successCount: successIds.length, total: characterIds.length, failedDetails };
    }

    async function updateFolderCover(folderId, coverUrl) {
        if (!coverUrl) return false;
        try {
            const res = await mufyPut(`${API_BASE}/api/favorites/`, { id: Number(folderId), coverUrls: [coverUrl] }, 1);
            return res?.code === 200;
        } catch (e) {
            console.warn('[Mufy] 更新封面失败:', e.message);
            return false;
        }
    }

    function addCollectionLog(text) {
        const stamp = new Date().toLocaleString('zh-CN');
        state.collectionLog.unshift(`[${stamp}] ${text}`);
        if (state.collectionLog.length > 20) state.collectionLog.length = 20;
    }
    function addFolderLog(text) {
        const stamp = new Date().toLocaleString('zh-CN');
        state.folderLog.unshift(`[${stamp}] ${text}`);
        if (state.folderLog.length > 30) state.folderLog.length = 30;
    }

    async function organizeByAuthor(setStatus, onlyFollowed) {
        const groups = new Map();
        state.roles.forEach(r => {
            if (onlyFollowed && !r.isFollowed) return;
            const aid = r.authorId || 'unknown';
            if (!groups.has(aid)) groups.set(aid, { authorId: aid, authorName: r.authorName || '未知作者', roles: [] });
            groups.get(aid).roles.push(r);
        });
        if (groups.size === 0) { setStatus('没有可整理的角色', true); return; }

        setStatus('正在读取现有收藏夹...');
        const folders = await fetchAllFavoriteFolders();
        const folderByName = new Map(folders.map(f => [f.name, f]));

        const log = [];
        let idx = 0;
        const total = groups.size;
        for (const [aid, group] of groups) {
            idx++;
            setStatus(`整理中 ${idx}/${total}：${group.authorName}`);

            if (!onlyFollowed) {
                const unfollowed = group.roles.filter(r => !r.isFollowed);
                for (const r of unfollowed) {
                    const res = await followCharacter(r.characterId, true);
                    if (res.ok) r.isFollowed = true;
                    await sleep(400);
                }
            }

            let folderName = group.authorName.slice(0, 30);
            let folder = folderByName.get(folderName);
            if (!folder) {
                const newId = await createFavoriteFolder(folderName);
                if (!newId) { log.push(`失败：${folderName} 创建收藏夹失败`); continue; }
                folder = { id: newId, name: folderName };
                folderByName.set(folderName, folder);
                await sleep(800);
            }

            const cids = group.roles.map(r => r.characterId);
            const result = await addCharactersToFolder(folder.id, cids);
            if (result.successCount > 0) {
                log.push(`成功：${folderName}，${result.successCount}/${result.total} 个角色${result.failedDetails.length ? `（${result.failedDetails.length} 失败）` : ''}`);

                const coverRole = group.roles.find(r => r.avatarUrl);
                if (coverRole) {
                    const okCover = await updateFolderCover(folder.id, coverRole.avatarUrl);
                    if (okCover) log[log.length - 1] += ' +封面';
                    await sleep(400);
                }
            } else {
                const reason = result.failedDetails[0]?.reason || result.failedDetails[0]?.error || '未知';
                log.push(`失败：${folderName} 全部失败（${reason}）`);
            }
            await sleep(300);
        }

        const successCount = log.filter(l => l.startsWith('成功')).length;
        addFolderLog(`整理完成：${successCount}/${total} 个作者\n${log.join('\n')}`);
        saveCache();
        setStatus(`整理完成：${successCount}/${total} 个作者成功`);
        return log;
    }
async function removeCharactersFromFolder(folderId, characterIds) {
    const ids = (Array.isArray(characterIds) ? characterIds : [characterIds]).filter(Boolean);
    if (!ids.length) return { successCount: 0, total: 0, failedDetails: [] };
    const BATCH = 20;
    let successCount = 0;
    const failedDetails = [];
    for (let i = 0; i < ids.length; i += BATCH) {
        const batch = ids.slice(i, i + BATCH);
        try {
            const res = await mufyPut(`${API_BASE}/api/favorites/characters`, {
                folderId: Number(folderId),
                removeCharacterIds: batch
            }, 2);
            if (res?.code === 200) successCount += batch.length;
            else failedDetails.push({ batch, reason: res?.reason });
        } catch (e) {
            failedDetails.push({ batch, error: e.message });
        }
        await sleep(400);
    }
    return { successCount, total: ids.length, failedDetails };
}

async function clearFolderViaKnownRoles(folderId) {
    const allCids = state.roles.map(r => r.characterId).filter(Boolean);
    if (!allCids.length) return { successCount: 0, total: 0 };
    return removeCharactersFromFolder(folderId, allCids);
}

async function organizeByTag(setStatus) {
    const rules = parseTagRules(localStorage.getItem(TAG_RULES_KEY) || '');
    if (!rules.length) { setStatus('请先填写标签规则', true); return; }
    if (!state.roles.length) { setStatus('请先扫描', true); return; }

    // 1. 补 tags，按规则分组（一个角色只进第一个命中的夹）
    const groups = new Map();
    const unmatched = [];
    const conflicts = [];
    for (let i = 0; i < state.roles.length; i++) {
        const role = state.roles[i];
        setStatus(`读取标签 ${i + 1}/${state.roles.length}：${role.name}`);
        const tags = await ensureRoleTags(role);
        const lower = tags.map(t => String(t).toLowerCase());
        let matched = null;
        for (const rule of rules) {
            if (lower.some(t => rule.tags.has(t))) {
                if (!matched) matched = rule;
                else conflicts.push(`「${role.name}」同时命中「${matched.folder}」和「${rule.folder}」，归入前者`);
            }
        }
        if (matched) {
            if (!groups.has(matched.folder)) groups.set(matched.folder, { folderName: matched.folder, roles: [] });
            groups.get(matched.folder).roles.push(role);
        } else unmatched.push(role.name);
        await sleep(300);
    }

    if (groups.size === 0) { setStatus('没有角色命中任何标签规则', true); return; }

    // 2. 建夹（不存在才建）+ 加角色。不清空已有内容，清空交给「清空旧夹」按钮
    setStatus('正在读取现有收藏夹...');
    const folders = await fetchAllFavoriteFolders();
    const folderByName = new Map(folders.map(f => [f.name, f]));

    const log = [];
    let idx = 0;
    for (const [folderName, group] of groups) {
        idx++;
        setStatus(`整理中 ${idx}/${groups.size}：${folderName}`);
        let folder = folderByName.get(folderName);
        if (!folder) {
            const newId = await createFavoriteFolder(folderName);
            if (!newId) { log.push(`失败：${folderName} 创建收藏夹失败`); continue; }
            folder = { id: newId, name: folderName };
            folderByName.set(folderName, folder);
            await sleep(800);
        }
        const cids = group.roles.map(r => r.characterId);
        const result = await addCharactersToFolder(folder.id, cids);
        if (result.successCount > 0) {
            log.push(`成功：${folderName}，${result.successCount}/${result.total} 个角色${result.failedDetails.length ? `（${result.failedDetails.length} 失败）` : ''}`);
            const coverRole = group.roles.find(r => r.avatarUrl);
            if (coverRole) {
                const okCover = await updateFolderCover(folder.id, coverRole.avatarUrl);
                if (okCover) log[log.length - 1] += ' +封面';
                await sleep(400);
            }
        } else {
            const reason = result.failedDetails[0]?.reason || result.failedDetails[0]?.error || '未知';
            log.push(`失败：${folderName} 全部失败（${reason}）`);
        }
        await sleep(300);
    }

    const successCount = log.filter(l => l.startsWith('成功')).length;
    let summary = `按标签整理完成：${successCount}/${groups.size} 个夹`;
    if (unmatched.length) summary += `\n未命中：${unmatched.length} 个角色`;
    if (conflicts.length) summary += `\n多规则命中：\n${conflicts.join('\n')}`;
    addFolderLog(`${summary}\n${log.join('\n')}`);
    saveCache();
    setStatus(`按标签整理完成：${successCount}/${groups.size} 个夹成功`);
    return log;
}
    function showFoldersDialog() {
        const overlay = document.createElement('div');
        overlay.className = 'mufy-mask-overlay';
        overlay.innerHTML = `
          <div class="mufy-mask-picker" style="width: 400px;">
            <div class="mufy-mask-picker-header">
              <div class="mufy-mask-picker-title">Mufy 收藏夹</div>
              <button class="mufy-mask-picker-close">×</button>
            </div>
            <div class="mufy-mask-picker-list" id="mufy-folders-list">
              <div class="mufy-mask-picker-loading">正在加载...</div>
            </div>
          </div>`;
        document.body.appendChild(overlay);
        const close = () => overlay.remove();
        overlay.querySelector('.mufy-mask-picker-close').addEventListener('click', close);
        overlay.addEventListener('click', e => { if (e.target === overlay) close(); });
        (async () => {
            const listEl = overlay.querySelector('#mufy-folders-list');
            const folders = await fetchAllFavoriteFolders();
            if (!folders.length) {
                listEl.innerHTML = `<div class="mufy-mask-picker-empty">还没有任何收藏夹<br><br><small style="color:#666;">点"整理已收藏"自动创建</small></div>`;
                return;
            }
            listEl.innerHTML = folders.map(f => `
              <div class="mufy-mask-picker-item">
                <div>
                  <div class="mufy-mask-name">${esc(f.name)}</div>
                  <div class="mufy-mask-gender">${f.characterCnt || 0} 个角色</div>
                </div>
                <a href="https://chat.mufy.ai/favorites" target="_blank" style="color:#888;font-size:11px;text-decoration:none;">查看</a>
              </div>`).join('');
        })();
    }

    // ============ 角色绑定面具 ============
    function showMaskPicker(cid, roleName, onPick) {
        const overlay = document.createElement('div');
        overlay.className = 'mufy-mask-overlay';
        overlay.innerHTML = `
          <div class="mufy-mask-picker">
            <div class="mufy-mask-picker-header">
              <div class="mufy-mask-picker-title">选择面具 · ${esc(roleName)}</div>
              <button class="mufy-mask-picker-close">×</button>
            </div>
            <div style="padding:8px 14px;border-bottom:1px solid #222;display:flex;gap:8px;align-items:center;">
              <span style="color:#666;font-size:11px;flex:1;">来自面具库</span>
              <button class="mufy-mask-tbtn" id="mufy-pk-sync" style="padding:3px 8px;font-size:11px;">同步</button>
              <button class="mufy-mask-tbtn primary" id="mufy-pk-new" style="padding:3px 8px;font-size:11px;">新增</button>
            </div>
            <div class="mufy-mask-picker-list"><div class="mufy-mask-picker-loading">正在加载面具库...</div></div>
          </div>`;
        document.body.appendChild(overlay);
        const close = () => overlay.remove();
        overlay.querySelector('.mufy-mask-picker-close').addEventListener('click', close);
        overlay.addEventListener('click', e => { if (e.target === overlay) close(); });

        const listEl = overlay.querySelector('.mufy-mask-picker-list');

        const currentBinding = state.maskBindings[cid];
        function isCurrent(item) {
            if (!currentBinding) return false;
            if (currentBinding.localId) return currentBinding.localId === item.localId;
            return currentBinding.maskId && currentBinding.maskId === item.officialMaskId;
        }

        function renderList() {
            const items = state.maskLibrary.items;
           if (!items.length) {
    listEl.innerHTML = `<div class="mufy-mask-picker-empty">面具库是空的<br><small style="color:#666;">点「同步」导入官方槽位，或「新增」</small></div>`;
    return;
}
            const sorted = [...items].sort((a, b) => {
                const aS = !!a.officialMaskId, bS = !!b.officialMaskId;
                if (aS !== bS) return bS - aS;
                return (b.lastUsedAt || 0) - (a.lastUsedAt || 0);
            });
            listEl.innerHTML = sorted.map(m => {
                const cur = isCurrent(m);
                return `
                <div class="mufy-mask-picker-item ${cur ? 'active' : ''}" data-local-id="${esc(m.localId)}">
                  <div style="min-width:0;flex:1;">
                    <div class="mufy-mask-name">${m.officialMaskId ? '[已激活]' : '[未激活]'} ${esc(m.maskName)}</div>
                    <div class="mufy-mask-gender">${esc(m.gender || '')}${m.remark ? ' · ' + esc(m.remark) : ''}</div>
                  </div>
                  ${cur ? '<span class="mufy-mask-current">当前</span>' : ''}
                </div>`;
            }).join('');
            listEl.querySelectorAll('.mufy-mask-picker-item').forEach(el => {
                el.addEventListener('click', async () => {
                    const localId = el.getAttribute('data-local-id');
                    const item = state.maskLibrary.items.find(i => i.localId === localId);
                    if (!item) return;
                    if (isCurrent(item)) { close(); return; }
                    listEl.innerHTML = `<div class="mufy-mask-picker-loading">准备中...</div>`;
                    try {
                        let officialId = item.officialMaskId;
                        if (!officialId) {
                            listEl.innerHTML = `<div class="mufy-mask-picker-loading">面具不在槽位，尝试激活...</div>`;
                            await promptActivateMask(item, null);
                            officialId = state.maskLibrary.items.find(i => i.localId === localId)?.officialMaskId;
                            if (!officialId) { renderList(); return; }
                        }
                        listEl.innerHTML = `<div class="mufy-mask-picker-loading">正在切换面具...</div>`;
                        const ok = await switchMask(cid, officialId, item.maskName, localId);
                        close();
                        if (ok) { addCollectionLog(`给「${roleName}」绑定了面具「${item.maskName}」`); onPick?.(officialId, item.maskName); }
                        else alert('切换面具失败，请稍后再试或 F12 看控制台');
                    } catch (err) {
                        alert('切换失败：' + err.message);
                        renderList();
                    }
                });
            });
        }

        overlay.querySelector('#mufy-pk-sync').addEventListener('click', async (e) => {
            e.target.disabled = true; e.target.textContent = '...';
            try { await syncMaskLibraryFromOfficial(); renderList(); }
            catch (err) { alert('同步失败：' + err.message); }
            e.target.disabled = false; e.target.textContent = '同步';
        });
        overlay.querySelector('#mufy-pk-new').addEventListener('click', () => {
            showMaskEditDialog(null, () => { renderList(); });
        });

        try {
            renderList();
        } catch (e) {
            listEl.innerHTML = `<div class="mufy-mask-picker-empty">加载失败：${esc(e.message)}</div>`;
        }
    }
function showClearFoldersDialog(onDone) {
    const overlay = document.createElement('div');
    overlay.className = 'mufy-mask-overlay';
    overlay.innerHTML = `
      <div class="mufy-mask-picker" style="width:420px;">
        <div class="mufy-mask-picker-header">
          <div class="mufy-mask-picker-title">清空收藏夹</div>
          <button class="mufy-mask-picker-close">×</button>
        </div>
        <div style="padding:8px 16px;color:#ffb74d;font-size:11px;border-bottom:1px solid #222;">
          只会移除「已扫描角色列表」里的角色；手动加的非扫描角色不受影响。
        </div>
        <div class="mufy-mask-picker-list" id="mufy-clear-list">
          <div class="mufy-mask-picker-loading">加载中...</div>
        </div>
        <div style="padding:12px 16px;border-top:1px solid #222;display:flex;justify-content:flex-end;gap:8px;">
          <button class="mufy-mask-tbtn" id="mufy-clear-cancel">取消</button>
          <button class="mufy-mask-tbtn primary" id="mufy-clear-go">清空所选</button>
        </div>
      </div>`;
    document.body.appendChild(overlay);
    const close = (v) => { overlay.remove(); onDone?.(v); };
    overlay.querySelector('.mufy-mask-picker-close').addEventListener('click', () => close(false));
    overlay.querySelector('#mufy-clear-cancel').addEventListener('click', () => close(false));
    overlay.addEventListener('click', e => { if (e.target === overlay) close(false); });

    const listEl = overlay.querySelector('#mufy-clear-list');
    (async () => {
        const folders = await fetchAllFavoriteFolders();
        if (!folders.length) {
            listEl.innerHTML = `<div class="mufy-mask-picker-empty">还没有收藏夹</div>`;
            return;
        }
        listEl.innerHTML = folders.map(f => `
          <label class="mufy-mask-picker-item" style="cursor:pointer;">
            <div style="display:flex;align-items:center;gap:10px;flex:1;min-width:0;">
              <input type="checkbox" class="mufy-clear-cb" value="${f.id}">
              <div style="min-width:0;">
                <div class="mufy-mask-name">${esc(f.name)}</div>
                <div class="mufy-mask-gender">${f.characterCnt || 0} 个角色</div>
              </div>
            </div>
          </label>`).join('');
    })();

    overlay.querySelector('#mufy-clear-go').addEventListener('click', async (e) => {
        const ids = [...overlay.querySelectorAll('.mufy-clear-cb:checked')].map(cb => cb.value);
        if (!ids.length) return;
        if (!confirm(`将清空 ${ids.length} 个夹中「已扫描角色列表」里的角色，继续？`)) return;
        e.target.disabled = true; e.target.textContent = '清空中...';
        let total = 0;
        for (const id of ids) {
            const r = await clearFolderViaKnownRoles(id);
            total += r.successCount || 0;
        }
        addFolderLog(`清空了 ${ids.length} 个收藏夹（移除 ${total} 个角色）`);
        close(true);
    });
}
    // ============ 收藏夹管理渲染 ============
    function renderCollection(contentEl) {
        const filter = state.collectionFilter || 'all';
        let filteredRoles = state.roles;
if (state.searchQuery) {
    const p = state.searchParsed || parseSearchToken(state.searchQuery);
    const q = (p.q || p.raw || '').toLowerCase();
    filteredRoles = filteredRoles.filter(r => {
        if (p.type === 'id' || p.type === 'roleId') return isSameId(r.characterId, p.id);
        if (p.type === 'authorId') return isSameId(r.authorId, p.id);
        return String(r.name).toLowerCase().includes(q) ||
               String(r.characterId).toLowerCase().includes(q) ||
               String(r.authorName || '').toLowerCase().includes(q) ||
               String(r.authorId || '').toLowerCase().includes(q);
    });
}
        if (filter === 'unfollowed') filteredRoles = filteredRoles.filter(r => !r.isFollowed);
        else if (filter === 'followed') filteredRoles = filteredRoles.filter(r => r.isFollowed);

        const groups = new Map();
        filteredRoles.forEach(r => {
            const aid = r.authorId || 'unknown';
            if (!groups.has(aid)) groups.set(aid, { authorId: aid, authorName: r.authorName || (aid === 'unknown' ? '未知/失效作者' : '未知作者'), roles: [] });
            groups.get(aid).roles.push(r);
        });
        const sortedGroups = [...groups.values()].sort((a, b) => b.roles.length - a.roles.length);

       const mode = state.collectionMode || 'author';
let html = '';

// 模式切换
html += `<div class="mufy-collection-filter" style="margin-bottom:8px;">
    <button class="mufy-filter-btn ${mode === 'author' ? 'active' : ''}" data-mode="author">按作者整理</button>
    <button class="mufy-filter-btn ${mode === 'tag' ? 'active' : ''}" data-mode="tag">按标签整理</button>
</div>`;

if (mode === 'author') {
    html += `<div class="mufy-folder-actions">
        <button class="mufy-folder-btn primary" id="mufy-organize-followed">整理已收藏</button>
        <button class="mufy-folder-btn" id="mufy-organize-all">全部整理</button>
        <button class="mufy-folder-btn" id="mufy-view-folders">查看收藏夹</button>
        <button class="mufy-folder-btn" id="mufy-clean-dead" style="color:#ff5252; border-color:#5a1f1f;">一键清理死卡</button>
    </div>`;
} else {
    const rulesRaw = localStorage.getItem(TAG_RULES_KEY) || '';
    html += `<div style="margin-bottom:12px; padding:10px; background:#0a0a0a; border:1px solid #222; border-radius:8px;">
        <div style="color:#888; font-size:11px; margin-bottom:6px;">标签规则（一行一个：夹名 = 标签1, 标签2）</div>
        <textarea id="mufy-tag-rules" class="mufy-input" style="width:100%; height:90px; background:#000; border:1px solid #333; border-radius:4px; padding:8px; color:#fff; font-size:12px; box-sizing:border-box; resize:vertical; outline:none;" placeholder="不洁 = 不洁, NTR, 脏&#10;狗男 = 狗男, 忠犬, 舔狗">${esc(rulesRaw)}</textarea>
        <div style="display:flex; gap:8px; margin-top:8px; flex-wrap:wrap;">
            <button class="mufy-folder-btn primary" id="mufy-organize-tag">按标签整理</button>
            <button class="mufy-folder-btn" id="mufy-view-folders">查看收藏夹</button>
            <button class="mufy-folder-btn" id="mufy-clear-folders" style="color:#ffb74d; border-color:#5a3a1f;">清空旧夹</button>
            <button class="mufy-folder-btn" id="mufy-clean-dead" style="color:#ff5252; border-color:#5a1f1f;">清理死卡</button>
        </div>
        <div style="color:#ffb74d; font-size:11px; margin-top:8px;">⚠️ 整理时只加不清。如果之前用作者模式整理过，建议先点「清空旧夹」，否则标签夹里会残留旧角色。</div>
    </div>`;
}

        const totalCount = state.roles.length;
        const unfollowedCount = state.roles.filter(r => !r.isFollowed).length;
        const followedCount = totalCount - unfollowedCount;
        html += `<div class="mufy-collection-filter">
            <button class="mufy-filter-btn ${filter === 'all' ? 'active' : ''}" data-filter="all">全部 ${totalCount}</button>
            <button class="mufy-filter-btn ${filter === 'unfollowed' ? 'active' : ''}" data-filter="unfollowed">未收藏 ${unfollowedCount}</button>
            <button class="mufy-filter-btn ${filter === 'followed' ? 'active' : ''}" data-filter="followed">已收藏 ${followedCount}</button>
        </div>`;

        if (state.collectionLog.length > 0) {
            html += `<details class="mufy-collection-log" ${state.collectionLog.length <= 3 ? 'open' : ''}>
                <summary>最近收藏操作 (${state.collectionLog.length})</summary>
                ${state.collectionLog.map(l => `<div class="mufy-log-line">${esc(l)}</div>`).join('')}
            </details>`;
        }
        if (state.folderLog.length > 0) {
            html += `<details class="mufy-collection-log" ${state.folderLog.length <= 2 ? 'open' : ''}>
                <summary>收藏夹整理日志 (${state.folderLog.length})</summary>
                ${state.folderLog.map(l => `<div class="mufy-log-line" style="white-space:pre-wrap;">${esc(l)}</div>`).join('')}
            </details>`;
        }

        if (!sortedGroups.length) {
            html += `<div class="mufy-empty">${filter === 'unfollowed' ? '全部收藏已清空' : filter === 'followed' ? '还没有收藏任何角色' : '暂无数据，请先扫描'}</div>`;
            contentEl.innerHTML = html;
            return;
        }

        html += sortedGroups.map(g => {
            const unfollowed = g.roles.filter(r => !r.isFollowed);
            const fCount = g.roles.length - unfollowed.length;
            return `
            <div class="mufy-author-group">
                <div class="mufy-group-header">
                    <div class="mufy-group-title">
                        <span class="mufy-group-name">${esc(g.authorName)}</span>
                        <span class="mufy-group-meta">${g.roles.length} 张卡 · 已收藏 ${fCount}</span>
                    </div>
                    ${unfollowed.length > 0
                        ? `<button class="mufy-follow-btn mufy-follow-all" data-author="${esc(g.authorId)}">一键收藏 ${unfollowed.length} 个</button>`
                        : `<span class="mufy-group-done">全收藏</span>`}
                </div>
                <div class="mufy-group-body">
                    ${g.roles.map(r => {
                        const bind = state.maskBindings[r.characterId];
                        let maskLabel = '';
                        if (bind) {
                            if (bind.localId) {
                                const libItem = state.maskLibrary.items.find(i => i.localId === bind.localId);
                                maskLabel = libItem ? libItem.maskName : bind.maskName;
                                if (libItem && !libItem.officialMaskId) maskLabel += ' [未激活]';
                            } else {
                                maskLabel = bind.maskName || '';
                            }
                        }
                        return `
                        <div class="mufy-collection-row">
                            <div class="mufy-collection-name">
                                ${r.isFollowed ? '[已藏]' : '[未藏]'} ${esc(r.name)}
                                ${r.rounds > 0 ? `<span class="mufy-collection-rounds">${r.rounds} 轮</span>` : ''}
                            </div>
                            <div class="mufy-collection-actions">
                                <button class="mufy-mask-btn ${bind ? 'has-mask' : ''}" data-cid="${esc(r.characterId)}" data-name="${esc(r.name)}" title="${bind ? '当前面具：' + esc(maskLabel) : '点击绑定面具'}">M: ${esc(maskLabel || '未绑定')}</button>
                                <button class="mufy-follow-btn mufy-follow-one" data-cid="${esc(r.characterId)}" data-followed="${r.isFollowed}">${r.isFollowed ? '取消收藏' : '收藏'}</button>
                            </div>
                        </div>`;
                    }).join('')}
                </div>
            </div>`;
        }).join('');

        contentEl.innerHTML = html;
    }

    // ============ 主页收割 Tab 渲染（多来源 + 抓取区间）============
    function renderHarvestTab(contentEl) {
        const h = state.harvest;
        const startIdx = h.lastStartIdx || 1;
        const endIdx = h.lastEndIdx || 10;
        const count = endIdx >= startIdx ? (endIdx - startIdx + 1) : 0;

        let html = `
          <div style="padding: 10px; font-size: 13px; color: #aaa; line-height: 1.6;">
            <div style="font-size: 14px; color: #fff; margin-bottom: 8px;">主页收割机</div>
            <div style="margin-bottom: 12px; color: #666;">按目标范围自动抓取角色，可批量收藏并发送打招呼消息。</div>

            <div style="margin-bottom:12px; padding:12px; background:#111; border:1px solid #333; border-radius:6px; ${h.running ? 'display:none;' : ''}">
                <div style="display:flex; gap:8px; align-items:center; margin-bottom:10px; flex-wrap:wrap;">
                    <span>抓取范围</span>
                    第 <input type="number" id="mufy-harvest-start-idx" class="mufy-input" value="${startIdx}" min="1" style="width:65px; text-align:center; padding:4px; background:#0a0a0a; border:1px solid #333; border-radius:4px; color:#fff;">
                    个 到 第 <input type="number" id="mufy-harvest-end-idx" class="mufy-input" value="${endIdx}" min="1" style="width:65px; text-align:center; padding:4px; background:#0a0a0a; border:1px solid #333; border-radius:4px; color:#fff;">
                    个 <span style="color:#888;">(共 ${count} 张)</span>
                </div>
                <div style="display:flex; gap:14px; flex-wrap:wrap;">
                    <label style="display:flex; align-items:center; gap:4px;">
                        <input type="checkbox" id="mufy-harvest-unfollowed" checked> 仅抓未收藏
                    </label>
                </div>

                <div style="margin-top:12px; padding-top:10px; border-top:1px dashed #333;">
                    <div style="color:#aaa; margin-bottom:8px; font-size:12px;">抓取来源（可多选，按顺序抓，自动去重合并）：</div>
                    <label style="display:flex; align-items:center; gap:6px; margin-bottom:6px;">
                        <input type="checkbox" class="mufy-harvest-source" value="trending_all" checked> 趋势榜 · 全部
                    </label>
                    <label style="display:flex; align-items:center; gap:6px; margin-bottom:6px;">
                        <input type="checkbox" class="mufy-harvest-source" value="trending_female"> 趋势榜 · 女性向
                    </label>
                    <label style="display:flex; align-items:center; gap:6px; margin-bottom:6px;">
                        <input type="checkbox" class="mufy-harvest-source" value="trending_bg"> 趋势榜 · BG
                    </label>
                    <label style="display:flex; align-items:center; gap:6px; margin-bottom:6px;">
                        <input type="checkbox" class="mufy-harvest-source" value="trending_custom"> 趋势榜 · 自定义标签
                        <input type="text" id="mufy-harvest-custom-tags" class="mufy-input" placeholder="如: 纯爱, 病娇（逗号分隔）" style="flex:1; padding:4px 8px; background:#000; border:1px solid #333; border-radius:4px; color:#fff; font-size:12px;">
                    </label>
                    <label style="display:flex; align-items:center; gap:6px; margin-bottom:6px;">
                        <input type="checkbox" class="mufy-harvest-source" value="star"> 关注榜（sortBy: star）
                    </label>
                    <label style="display:flex; align-items:center; gap:6px; margin-bottom:6px;">
                        <input type="checkbox" class="mufy-harvest-source" value="author"> 作者主页所有角色
                    </label>
                    <input type="text" id="mufy-harvest-author-input" class="mufy-input" placeholder="作者主页链接或 creatorId（多个用逗号/空格分隔）" style="width:100%; box-sizing:border-box; padding:6px; background:#000; border:1px solid #333; border-radius:4px; color:#fff; margin-top:4px;">
                </div>
            </div>

            <div style="margin-bottom:12px; padding:12px; background:#111; border:1px solid #333; border-radius:6px; ${h.running ? 'display:none;' : ''}">
                <label style="display:flex; align-items:center; gap:6px; margin-bottom:8px; color:#ccc; font-weight:500;">
                    <input type="checkbox" id="mufy-harvest-send-msg"> 自动发送打招呼（会扣除对话次数）
                </label>
                <input type="text" id="mufy-harvest-msg-text" class="mufy-input" value="你好" placeholder="发送的内容..." style="width:100%; box-sizing:border-box; padding:6px; background:#000; border:1px solid #333; border-radius:4px; color:#fff;">
            </div>

            <button class="mufy-btn" id="mufy-harvest-start" style="width: 100%; height: 40px; margin-bottom: 12px; background:#fff; color:#000; font-weight:600; ${h.running ? 'display:none;' : ''}">开始执行</button>

            <div id="mufy-harvest-status" style="font-size:12px; color:${h.running ? '#fff' : '#888'}; margin-bottom:12px; font-weight:500; word-break:break-all;">${h.status}</div>

            <div id="mufy-harvest-result" style="background:#0a0a0a; border:1px solid #222; border-radius:8px; padding:12px; font-size:12px; max-height:300px; overflow-y:auto; display:${(h.successFollow.length || h.successMsg.length || h.running) ? 'block' : 'none'};">
                <div style="font-weight:500; margin-bottom:8px; color:#fff;">执行记录：</div>
                <div id="mufy-harvest-list" style="color:#888; line-height:1.6;">
                    ${h.successFollow.map(name => `<div style="color:#ccc; margin-bottom:2px;">[收藏] ${esc(name)}</div>`).join('')}
                    ${h.successMsg.map(name => `<div style="color:#ccc; margin-bottom:2px;">[打招呼] ${esc(name)}</div>`).join('')}
                </div>
            </div>
          </div>
        `;
        contentEl.innerHTML = html;
        bindHarvestEvents(contentEl);
    }

    async function sendHelloToCharacter(characterId, msgText) {
        try {
            const sRes = await mufyPost(`${API_BASE}/api/sessions/create`, { characterId: characterId }, 1);
            let sessionId = '';
            if (sRes && sRes.code === 200 && sRes.data) {
                if (typeof sRes.data === 'string') sessionId = sRes.data;
                else sessionId = sRes.data.sessionId || sRes.data.id || sRes.data.data;
            }
            if (!sessionId) return false;

            const headers = { 'Content-Type': 'application/json', 'Accept': 'application/json, text/plain, */*', 'Authorization': getAuthorization(), 'Origin': 'https://chat.mufy.ai', 'Referer': 'https://chat.mufy.ai/' };
            const res = await fetch(`${API_BASE}/api/v1/chat/completions`, {
                method: 'POST', headers,
                body: JSON.stringify({ characterId: characterId, sessionId: sessionId, userInput: msgText, itemText: null, maskId: 7730987, modelId: 25, modelTemplateId: 67, skipRedPacket: false })
            });

            if (res.ok && res.body) {
                const reader = res.body.getReader();
                while (true) { const { done } = await reader.read(); if (done) break; }
                return true;
            }
            return false;
        } catch (e) { return false; }
    }

    // ============ 收割辅助函数 ============
    const HARVEST_SOURCES = {
        trending_all:    { type: 'rank', sortBy: 'trending', tags: [], label: '趋势榜·全部' },
        trending_female: { type: 'rank', sortBy: 'trending', tags: ['女性向'], label: '趋势榜·女性向' },
        trending_bg:     { type: 'rank', sortBy: 'trending', tags: ['BG'], label: '趋势榜·BG' },
        trending_custom: { type: 'rank', sortBy: 'trending', tags: [], label: '趋势榜·自定义' },
        star:            { type: 'rank', sortBy: 'star', tags: [], label: '关注榜' },
        author:          { type: 'author', label: '作者主页' }
    };

    function parseAuthorIds(raw) {
        if (!raw) return [];
        const ids = new Set();
        const parts = raw.split(/[\s,，;；]+/).filter(Boolean);
        const uuidRegex = /[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i;
        for (const part of parts) {
            const m = part.match(uuidRegex);
            if (m) { ids.add(m[0]); continue; }
            try {
                const u = new URL(part);
                const id = u.searchParams.get('id') || u.searchParams.get('userId') || u.searchParams.get('creatorId');
                if (id) { ids.add(id); continue; }
            } catch (e) {}
            if (part.length >= 16) ids.add(part);
        }
        return [...ids];
    }
const UUID_RE = /[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i;

function parseSearchToken(raw) {
  const input = String(raw || '').trim();
  if (!input) return { type: 'empty' };

  // 1) 直接 UUID
  const m = input.match(UUID_RE);
  if (m) return { type: 'id', id: m[0], raw: input };

  // 2) URL 解析
  try {
    const u = new URL(input, location.origin);
    const sp = u.searchParams;
    if (sp.has('roleId'))      return { type: 'roleId', id: sp.get('roleId'), raw: input };
    if (sp.has('sessionId'))   return { type: 'sessionId', id: sp.get('sessionId'), raw: input };
    if (sp.has('shareCode'))   return { type: 'shareCode', id: sp.get('shareCode'), raw: input };
    if (sp.has('creatorId'))   return { type: 'authorId', id: sp.get('creatorId'), raw: input };
    if (sp.has('id')) {
      // profile/role?id=  → 作者；其它 → 角色
      if (/\/profile\//i.test(u.pathname)) return { type: 'authorId', id: sp.get('id'), raw: input };
      return { type: 'id', id: sp.get('id'), raw: input };
    }
    if (/\/chat\//i.test(u.pathname) || /\/role\//i.test(u.pathname)) {
      return { type: 'roleUrl', raw: input, url: u };
    }
  } catch (e) { /* 不是 URL，继续 */ }

  // 3) 纯关键词
  return { type: 'keyword', raw: input, q: input.toLowerCase() };
}
    async function harvestRankList(sortBy, tags, startIdx, endIdx, onlyUnfollowed, allChars, setStatus, label) {
        const limitCount = endIdx - startIdx + 1;
        let scannedCount = 0;
        let page = 1;
        const PAGE_SIZE = 16;
        let emptyPages = 0;
        const MAX_PAGES = 500;

        while (allChars.size < limitCount && page <= MAX_PAGES && emptyPages < 3) {
            setStatus(`${label} 第 ${page} 页（已收集 ${allChars.size}/${limitCount}）...`);
            let res;
            try {
                res = await mufyPost(`${API_BASE}/api/characters/query`, {
                    pageNum: page, pageSize: PAGE_SIZE, sortBy,
                    genderText: '全性别', tags, showNsfw: false, search: ''
                });
            } catch (e) {
                emptyPages++; page++; await sleep(800); continue;
            }
            const data = res?.data?.data;
            if (!Array.isArray(data) || data.length === 0) {
                emptyPages++; page++; await sleep(600); continue;
            }
            emptyPages = 0;

            for (const c of data) {
                if (allChars.size >= limitCount) break;
                const cid = c.characterId || c.id;
                if (!cid || allChars.has(cid)) continue;
                if (onlyUnfollowed && c.isFollowed) continue;

                scannedCount++;
                if (scannedCount >= startIdx) {
                    allChars.set(cid, {
                        characterId: cid,
                        name: c.name || c.characterName || c.title || '未命名',
                        authorId: c.creatorId || c.authorId || c.userId || '',
                        authorName: c.creatorName || c.authorName || '',
                        isFollowed: Boolean(c.isFollowed)
                    });
                }
            }

            if (res?.data?.hasNext === false) break;
            if (data.length < PAGE_SIZE) break;
            page++;
            await sleep(800);
        }
    }

    async function harvestAuthorCharacters(authorIds, startIdx, endIdx, onlyUnfollowed, allChars, setStatus) {
        const limitCount = endIdx - startIdx + 1;
        let scannedCount = 0;
        for (let i = 0; i < authorIds.length; i++) {
            if (allChars.size >= limitCount) return;
            const creatorId = authorIds[i];
            setStatus(`抓取作者 ${i + 1}/${authorIds.length} (${creatorId.slice(0, 8)}...) 的角色...`);
            try {
                const res = await mufyGet(`${API_BASE}/api/characters/list?creatorId=${encodeURIComponent(creatorId)}`);
                if (res?.code === 200 && Array.isArray(res.data) && res.data.length > 0) {
                    for (const c of res.data) {
                        if (allChars.size >= limitCount) break;
                        const cid = c.characterId || c.id;
                        if (!cid || allChars.has(cid)) continue;
                        if (onlyUnfollowed && c.isFollowed) continue;

                        scannedCount++;
                        if (scannedCount >= startIdx) {
                            allChars.set(cid, {
                                characterId: cid,
                                name: c.name || c.characterName || c.title || '未命名',
                                authorId: c.creatorId || c.authorId || c.userId || '',
                                authorName: c.creatorName || c.authorName || '',
                                isFollowed: Boolean(c.isFollowed)
                            });
                        }
                    }
                }
            } catch (e) {}
            await sleep(600);
        }
    }

function parseTagRules(raw) {
    const rules = [];
    String(raw || '').split('\n').forEach(line => {
        line = line.trim();
        if (!line || line.startsWith('#')) return;
        const m = line.match(/^([^=:：]+)[=:：](.+)$/);
        if (!m) return;
        const folder = m[1].trim();
        const tags = m[2].split(/[,，;；\s]+/).map(t => t.trim()).filter(Boolean);
        if (folder && tags.length) rules.push({ folder, tags: new Set(tags.map(t => t.toLowerCase())) });
    });
    return rules;
}

async function ensureRoleTags(role) {
    if (Array.isArray(role.tags) && role.tags.length) return role.tags;
    try {
        const res = await mufyGet(`${API_BASE}/api/characters/get?id=${encodeURIComponent(role.characterId)}`);
        const d = res?.data?.data || res?.data || res;
        if (Array.isArray(d?.tags)) role.tags = d.tags;
    } catch (e) {}
    return role.tags || [];
}
    // ============ 主页收割事件绑定 ============
    function bindHarvestEvents(contentEl) {
        const harvestBtn = contentEl.querySelector('#mufy-harvest-start');
        if (!harvestBtn) return;

        harvestBtn.addEventListener('click', async () => {
            const startIdx = Math.max(1, parseInt(contentEl.querySelector('#mufy-harvest-start-idx').value) || 1);
            const endIdx = Math.max(startIdx, parseInt(contentEl.querySelector('#mufy-harvest-end-idx').value) || 10);
            const onlyUnfollowed = contentEl.querySelector('#mufy-harvest-unfollowed').checked;
            const sendMsg = contentEl.querySelector('#mufy-harvest-send-msg').checked;
            const msgText = contentEl.querySelector('#mufy-harvest-msg-text').value.trim() || "你好";

            const selectedSources = [];
            contentEl.querySelectorAll('.mufy-harvest-source:checked').forEach(cb => selectedSources.push(cb.value));
            if (selectedSources.length === 0) return alert('请至少选择一个抓取来源');

            const customTagsRaw = contentEl.querySelector('#mufy-harvest-custom-tags').value.trim();
            const customTags = customTagsRaw ? customTagsRaw.split(/[,，;；\s]+/).filter(Boolean) : [];

            let authorIds = [];
            if (selectedSources.includes('author')) {
                authorIds = parseAuthorIds(contentEl.querySelector('#mufy-harvest-author-input').value.trim());
                if (authorIds.length === 0) return alert('选择了作者主页但没解析到有效作者 ID');
            }

            if (sendMsg && !confirm(`警告：你勾选了自动发消息，这会扣除额度！\n请保持网页在前台，确定执行吗？`)) return;

            const h = state.harvest;
            h.running = true;
            h.status = '准备开始...';
            h.successFollow = [];
            h.successMsg = [];
            h.lastStartIdx = startIdx;
            h.lastEndIdx = endIdx;

            renderHarvestTab(contentEl);

            const statusEl = contentEl.querySelector('#mufy-harvest-status');
            const resultBox = contentEl.querySelector('#mufy-harvest-result');
            const listEl = contentEl.querySelector('#mufy-harvest-list');
            const setStatus = (text) => { h.status = text; if (statusEl) statusEl.textContent = text; };

            const allChars = new Map();
            const chattedCharacterIds = new Set();

            try {
                if (sendMsg) {
                    setStatus('正在拉取历史聊天记录...');
                    try {
                        for (let p = 1; p <= 5; p++) {
                            const histRes = await mufyGet(`${API_BASE}/api/characters/query_session?pageNum=${p}&pageSize=100&isFollowed=false`);
                            const histData = histRes?.data?.data;
                            if (Array.isArray(histData) && histData.length > 0) {
                                histData.forEach(item => {
                                    const cid = item.characterId || item.id;
                                    if (cid) chattedCharacterIds.add(cid);
                                });
                                if (histData.length < 100) break;
                            } else break;
                        }
                    } catch (e) {}
                }

                for (const src of selectedSources) {
                    if (allChars.size >= (endIdx - startIdx + 1)) break;
                    const cfg = HARVEST_SOURCES[src];
                    if (!cfg) continue;
                    if (cfg.type === 'author') {
                        await harvestAuthorCharacters(authorIds, startIdx, endIdx, onlyUnfollowed, allChars, setStatus);
                    } else {
                        let tags = cfg.tags;
                        let label = cfg.label;
                        if (src === 'trending_custom') {
                            if (customTags.length === 0) continue;
                            tags = customTags;
                            label = `趋势榜·[${customTags.join('/')}]`;
                        }
                        await harvestRankList(cfg.sortBy, tags, startIdx, endIdx, onlyUnfollowed, allChars, setStatus, label);
                    }
                }

                const charArray = [...allChars.values()];
                if (charArray.length === 0) {
                    setStatus('未抓取到符合条件的角色，请检查区间或来源。');
                    h.running = false;
                    renderHarvestTab(contentEl);
                    return;
                }

                setStatus(`抓取完成，共 ${charArray.length} 个角色，开始处理...`);

                for (let i = 0; i < charArray.length; i++) {
                    const c = charArray[i];
                    setStatus(`处理中 (${i + 1}/${charArray.length})：${c.name}`);

                    if (!c.isFollowed) {
                        const res = await followCharacter(c.characterId, true);
                        if (res.ok) {
                            h.successFollow.push(c.name);
                            c.isFollowed = true;
                            if (listEl) {
                                listEl.insertAdjacentHTML('beforeend', `<div style="color:#ccc; margin-bottom:2px;">[收藏] ${esc(c.name)}</div>`);
                                if (resultBox) resultBox.style.display = 'block';
                            }
                            const existing = state.roles.find(r => r.characterId === c.characterId);
                            if (existing) existing.isFollowed = true;
                            else state.roles.push({
                                characterId: c.characterId, name: c.name, authorId: c.authorId, authorName: c.authorName,
                                rounds: 0, hasCommented: false, isScanning: false, hasScanned: true,
                                isExpired: false, isFollowed: true, lastSessionId: null
                            });
                            saveCache();
                        }
                        await sleep(500);
                    }

                    if (sendMsg) {
                        let hasChatted = chattedCharacterIds.has(c.characterId);
                        if (!hasChatted) {
                            const localRole = state.roles.find(r => r.characterId === c.characterId);
                            if (localRole && (localRole.rounds > 0 || localRole.lastSessionId)) hasChatted = true;
                        }
                        if (hasChatted) {
                            h.successMsg.push(`${c.name}(聊过)`);
                            if (listEl) {
                                listEl.insertAdjacentHTML('beforeend', `<div style="color:#888; margin-bottom:2px;">[跳过打招呼] ${esc(c.name)} (已有记录)</div>`);
                                if (resultBox) resultBox.style.display = 'block';
                            }
                            continue;
                        }

                        setStatus(`正在打招呼 (${i + 1}/${charArray.length})：${c.name}`);
                        const ok = await sendHelloToCharacter(c.characterId, msgText);
                        if (ok) {
                            h.successMsg.push(c.name);
                            if (listEl) {
                                listEl.insertAdjacentHTML('beforeend', `<div style="color:#ccc; margin-bottom:2px;">[打招呼] ${esc(c.name)}</div>`);
                                if (resultBox) resultBox.style.display = 'block';
                            }
                            const localRole = state.roles.find(r => r.characterId === c.characterId);
                            if (localRole) localRole.lastSessionId = 'temp_from_harvest';
                        } else {
                            if (listEl) {
                                listEl.insertAdjacentHTML('beforeend', `<div style="color:#ff5252; margin-bottom:2px;">[打招呼失败] ${esc(c.name)}</div>`);
                                if (resultBox) resultBox.style.display = 'block';
                            }
                        }
                        await sleep(Math.floor(Math.random() * 3000) + 3000);
                    }
                }

                addCollectionLog(`主页收割完成（${charArray.length} 个角色）`);
                setStatus(`执行完成。收藏 ${h.successFollow.length} 个`);
                h.running = false;
                renderHarvestTab(contentEl);

            } catch (err) {
                setStatus('抓取失败：' + err.message);
                h.running = false;
                renderHarvestTab(contentEl);
            }
        });
    }
    // ============ 面具库渲染 ============
    function renderMaskLibrary(contentEl) {
    const allItems = state.maskLibrary.items;
    // ★ 搜索过滤（只影响列表展示，不影响槽位统计）
    let items = allItems;
    if (state.searchQuery) {
        const q = state.searchQuery.toLowerCase();
        items = allItems.filter(m =>
            String(m.maskName || '').toLowerCase().includes(q) ||
            String(m.gender || '').toLowerCase().includes(q) ||
            String(m.remark || '').toLowerCase().includes(q) ||
            String(m.description || '').toLowerCase().includes(q)
        );
    }
    const inSlot = allItems.filter(i => i.officialMaskId).length;
    let html = `
          <div class="mufy-folder-actions">
            <button class="mufy-folder-btn primary" id="mufy-lib-sync">同步官方槽位</button>
            <button class="mufy-folder-btn" id="mufy-lib-new">新增面具</button>
          </div>
          <div style="color:#888;font-size:12px;padding:0 4px 8px;">
            槽位占用 ${inSlot} · 本地库共 ${items.length} 个面具
            <div style="color:#666;font-size:11px;">点「激活」把本地面具放到官方槽位；槽位满时选一个替换</div>
          </div>`;

        if (!items.length) {
            html += `<div class="mufy-empty">面具库是空的<br><small style="color:#666;">点「同步官方槽位」导入现有面具</small></div>`;
            contentEl.innerHTML = html;
            bindMaskLibraryEvents(contentEl);
            return;
        }
        const sorted = [...items].sort((a, b) => {
            const aS = !!a.officialMaskId, bS = !!b.officialMaskId;
            if (aS !== bS) return bS - aS;
            return (b.lastUsedAt || 0) - (a.lastUsedAt || 0);
        });
        html += sorted.map(m => `
          <div class="mufy-author-group" style="margin-bottom:8px;">
            <div style="padding:10px 14px;display:flex;justify-content:space-between;align-items:center;gap:10px;">
              <div style="flex:1;min-width:0;">
                <div style="font-size:13px;color:#fff;">
                  ${m.officialMaskId ? '[已激活]' : '[未激活]'} ${esc(m.maskName)}
                  ${m.officialMaskId ? '<span style="color:#888;font-size:11px;margin-left:6px;">槽位中</span>' : ''}
                </div>
                <div style="color:#666;font-size:11px;margin-top:2px;">
                  ${esc(m.gender || '未知')}${m.remark ? ' · ' + esc(m.remark) : ''}
                </div>
              </div>
              <div style="display:flex;gap:6px;flex:none;">
                <button class="mufy-folder-btn" data-lib-act="activate" data-local-id="${esc(m.localId)}" ${m.officialMaskId ? 'disabled' : ''}>${m.officialMaskId ? '已在槽位' : '激活'}</button>
                <button class="mufy-folder-btn" data-lib-act="edit" data-local-id="${esc(m.localId)}">编辑</button>
                <button class="mufy-folder-btn" data-lib-act="delete" data-local-id="${esc(m.localId)}">删除</button>
              </div>
            </div>
          </div>`).join('');
        contentEl.innerHTML = html;
        bindMaskLibraryEvents(contentEl);
    }

    function bindMaskLibraryEvents(contentEl) {
        const syncBtn = contentEl.querySelector('#mufy-lib-sync');
        const newBtn = contentEl.querySelector('#mufy-lib-new');
        if (syncBtn) syncBtn.addEventListener('click', async (e) => {
            e.target.disabled = true; e.target.textContent = '同步中...';
            try { await syncMaskLibraryFromOfficial(); }
            catch (err) { alert('同步失败：' + err.message); }
            renderMaskLibrary(contentEl);
        });
        if (newBtn) newBtn.addEventListener('click', () => {
            showMaskEditDialog(null, () => renderMaskLibrary(contentEl));
        });
        contentEl.querySelectorAll('[data-lib-act]').forEach(btn => {
            btn.addEventListener('click', async () => {
                const act = btn.getAttribute('data-lib-act');
                const localId = btn.getAttribute('data-local-id');
                const item = state.maskLibrary.items.find(i => i.localId === localId);
                if (!item) return;
                if (act === 'edit') return showMaskEditDialog(item, () => renderMaskLibrary(contentEl));
                if (act === 'delete') {
                    if (!confirm(`确定删除面具「${item.maskName}」？${item.officialMaskId ? '\n（会同时删除官方槽位）' : ''}`)) return;
                    try { await deleteLibraryMask(localId); renderMaskLibrary(contentEl); }
                    catch (err) { alert('删除失败：' + err.message); }
                    return;
                }
                if (act === 'activate') {
                    btn.disabled = true; btn.textContent = '...';
                    try { await promptActivateMask(item, () => renderMaskLibrary(contentEl)); }
                    catch (err) { alert('激活失败：' + err.message); }
                    btn.disabled = false;
                }
            });
        });
    }

    function esc(v) { return String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }


       // ============ 备忘录渲染 ============
    function renderMemoTab(contentEl) {
        let html = `
          <div style="padding: 10px; display:flex; flex-direction:column; height:100%; box-sizing:border-box;">
            <div style="font-size: 14px; color: #fff; margin-bottom: 8px;">本地备忘录</div>
            <div style="margin-bottom: 12px; color: #666; font-size:12px;">内容实时自动保存，刷新/切号都不会丢。</div>
            <textarea id="mufy-memo-input" class="mufy-input" style="flex:1; background:#0a0a0a; border:1px solid #333; border-radius:6px; padding:12px; color:#fff; font-size:13px; line-height:1.6; resize:none; min-height: 350px; outline:none; box-sizing:border-box;" placeholder="在这里记录你的脑洞、NPC好感度、跑团设定..."></textarea>
            <div style="display:flex; justify-content:flex-end; margin-top:12px;">
                <button class="mufy-folder-btn" id="mufy-memo-clear" style="color:#ff5252; border-color:#5a1f1f;">清空内容</button>
            </div>
          </div>
        `;
        contentEl.innerHTML = html;

        const input = contentEl.querySelector('#mufy-memo-input');
        const clearBtn = contentEl.querySelector('#mufy-memo-clear');

        // ★ 用 JS 赋值，比直接写死在 HTML 里更安全
        input.value = localStorage.getItem('mufy_memo_text') || '';

        // 实时保存
        input.addEventListener('input', (e) => {
            localStorage.setItem('mufy_memo_text', e.target.value);
        });

        clearBtn.addEventListener('click', () => {
            if (confirm('确定要清空备忘录吗？')) {
                input.value = '';
                localStorage.setItem('mufy_memo_text', '');
            }
        });
}


    // ============ 剧情快照渲染 ============
        // ============ 剧情快照渲染（上帝视角版） ============
    function renderArchiveTab(contentEl) {
        // 初始化状态
        const urlParams = new URLSearchParams(location.search);
        const currentRoleId = urlParams.get('roleId');

        let html = `
          <div style="padding: 10px; font-size: 13px; color: #aaa; line-height: 1.6;">
            <div style="font-size: 14px; color: #fff; margin-bottom: 8px;">剧情快照存档</div>
            <div style="margin-bottom: 12px; color: #666;">抓取任意角色的历史存档，连同当时绑定的面具一起打包。</div>

            <div style="background:#0a0a0a; border:1px solid #333; border-radius:6px; padding:12px; margin-bottom:16px;">
                <div style="display:flex; gap:8px; margin-bottom:12px;">
                    <select id="mufy-archive-role-select" class="mufy-input" style="flex:1; padding:6px; background:#000; border:1px solid #333; border-radius:4px; color:#fff;">
                        <option value="">加载角色列表中...</option>
                    </select>
                    <button class="mufy-folder-btn" id="mufy-archive-load-btn" style="flex:none;">读取存档</button>
                </div>

                <div id="mufy-archive-info" style="display:none; background:#111; border:1px solid #222; border-radius:4px; padding:10px; margin-bottom:12px;">
                    <div style="color:#fff; margin-bottom:4px;">角色: <span id="mufy-archive-char-name">-</span></div>
                    <div style="color:#00bcd4;">当前绑定面具: <span id="mufy-archive-mask-name">-</span></div>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                    <span style="color:#aaa; font-size:12px;">选择要导出的存档：</span>
                    <label style="display:flex; align-items:center; gap:4px; cursor:pointer; font-size:11px;">
                        <input type="checkbox" id="mufy-archive-select-all"> 全选
                    </label>
                </div>
                <div id="mufy-archive-list" style="max-height:200px; overflow-y:auto; background:#050505; border:1px solid #222; border-radius:4px; padding:6px; margin-bottom:12px;">
                    <div style="text-align:center; color:#555; font-size:12px; padding:10px;">请先选择角色并读取</div>
                </div>

                <div style="display:flex; gap:8px; margin-bottom:12px;">
                    <label style="display:flex; align-items:center; gap:4px; font-size:12px; color:#ccc;">
                        <input type="checkbox" id="mufy-archive-pure-text" checked> 纯正文（去状态栏代码）
                    </label>
                </div>

                <div style="display:flex; gap:8px;">
                    <button class="mufy-btn" id="mufy-archive-export-md" style="flex:1; height:36px; background:#fff; color:#000;">导出 Markdown</button>
                    <button class="mufy-folder-btn" id="mufy-archive-export-json" style="flex:1; height:36px; justify-content:center;">导出 JSON 备份</button>
                </div>
            </div>
          </div>
        `;
        contentEl.innerHTML = html;

        const roleSelect = contentEl.querySelector('#mufy-archive-role-select');
        const loadBtn = contentEl.querySelector('#mufy-archive-load-btn');
        const infoBox = contentEl.querySelector('#mufy-archive-info');
        const charNameEl = contentEl.querySelector('#mufy-archive-char-name');
        const maskNameEl = contentEl.querySelector('#mufy-archive-mask-name');
        const listBox = contentEl.querySelector('#mufy-archive-list');
        const selectAllCb = contentEl.querySelector('#mufy-archive-select-all');
        const exportMdBtn = contentEl.querySelector('#mufy-archive-export-md');
        const exportJsonBtn = contentEl.querySelector('#mufy-archive-export-json');
        const pureTextCb = contentEl.querySelector('#mufy-archive-pure-text');

        let loadedArchives = []; // 当前加载的存档列表
        let currentCharId = '';

        // 1. 填充角色列表
        if (state.roles.length === 0) {
            roleSelect.innerHTML = '<option value="">请先在"角色数据"扫描一次</option>';
        } else {
            roleSelect.innerHTML = state.roles.map(r => `<option value="${r.characterId}">${esc(r.name)}</option>`).join('');
            // 默认选中当前聊天的角色
            if (currentRoleId) {
                roleSelect.value = currentRoleId;
            }
        }

        // 2. 点击读取存档
        loadBtn.addEventListener('click', async () => {
            currentCharId = roleSelect.value;
            if (!currentCharId) return alert('请先选择一个角色');

            loadBtn.disabled = true; loadBtn.textContent = '...';
            listBox.innerHTML = '<div style="text-align:center; color:#666; padding:10px;">正在拉取存档节点...</div>';
            infoBox.style.display = 'block';

            // 获取角色信息与面具绑定
            const roleObj = state.roles.find(r => r.characterId === currentCharId);
            charNameEl.textContent = roleObj ? roleObj.name : '未知角色';

            let maskLabel = '未绑定';
            if (state.maskBindings[currentCharId]) {
                const bind = state.maskBindings[currentCharId];
                if (bind.localId) {
                    const libItem = state.maskLibrary.items.find(i => i.localId === bind.localId);
                    maskLabel = libItem ? libItem.maskName : bind.maskName;
                } else {
                    maskLabel = bind.maskName || '未知面具';
                }
            }
            maskNameEl.textContent = maskLabel;

            try {
                               // 拉取所有存档
                const archivesRes = await mufyGet(`${API_BASE}/api/sessions/query_archives?characterId=${currentCharId}`);
                // 兼容性处理：直接取 data 数组，如果没有再尝试取 data.data
                loadedArchives = Array.isArray(archivesRes?.data) ? archivesRes.data : (archivesRes?.data?.data || []);

                // 尝试把当前活跃聊天的 lastSessionId 找出来
                let lastSessionId = roleObj?.lastSessionId || '';
                if (currentRoleId === currentCharId) {
                     const urlSid = new URLSearchParams(location.search).get('sessionId');
                     if (urlSid) lastSessionId = urlSid;
                }

                let listHtml = '';

                // 先加上"当前最新未存档"
                if (lastSessionId) {
                    listHtml += `
                    <label style="display:flex; align-items:flex-start; gap:8px; padding:8px; border-bottom:1px solid #222; cursor:pointer; color:#fff;">
                        <input type="checkbox" class="archive-cb" data-sid="${lastSessionId}" checked style="margin-top:3px;">
                        <div>
                            <div style="color:#4caf50; font-weight:500;">🟢 当前活跃对话 (未存档)</div>
                            <div style="color:#888; font-size:11px;">SID: ${lastSessionId.slice(0, 8)}...</div>
                        </div>
                    </label>`;
                }

                // 加上历史存档
                if (loadedArchives.length === 0 && !lastSessionId) {
                    listHtml += '<div style="text-align:center; color:#666; padding:10px;">这个角色没有任何聊天记录</div>';
                } else {
                    loadedArchives.forEach(a => {
                        const d = new Date(a.createdAt).toLocaleString('zh-CN');
                        const remark = a.remark ? `<span style="color:#ffb74d;">[${esc(a.remark)}]</span>` : '';
                        listHtml += `
                        <label style="display:flex; align-items:flex-start; gap:8px; padding:8px; border-bottom:1px solid #222; cursor:pointer; color:#ccc;">
                            <input type="checkbox" class="archive-cb" data-sid="${a.sourceSessionId}" checked style="margin-top:3px;">
                            <div>
                                <div style="font-size:12px;"> ${d} ${remark}</div>
                                <div style="color:#666; font-size:11px;">SID: ${a.sourceSessionId.slice(0, 8)}...</div>
                            </div>
                        </label>`;
                    });
                }

                listBox.innerHTML = listHtml;

            } catch (err) {
                listBox.innerHTML = `<div style="text-align:center; color:#ff5252; padding:10px;">读取失败: ${err.message}</div>`;
            } finally {
                loadBtn.disabled = false; loadBtn.textContent = '读取存档';
            }
        });

        // 3. 全选逻辑
        selectAllCb.addEventListener('change', (e) => {
            const cbs = listBox.querySelectorAll('.archive-cb');
            cbs.forEach(cb => cb.checked = e.target.checked);
        });

        // 4. 核心抓取与导出逻辑
        async function doExport(format) {
            const selectedCbs = Array.from(listBox.querySelectorAll('.archive-cb:checked'));
            if (selectedCbs.length === 0) return alert('请至少勾选一个存档！');

            const isPure = pureTextCb.checked;
            const charName = charNameEl.textContent;
            const maskName = maskNameEl.textContent;
            const maskBind = state.maskBindings[currentCharId] || null;

            exportMdBtn.disabled = true; exportJsonBtn.disabled = true;
            exportMdBtn.textContent = '抓取中...';

            try {
                let allDialogs = [];
                for (let i = 0; i < selectedCbs.length; i++) {
                    const sid = selectedCbs[i].getAttribute('data-sid');
                    exportMdBtn.textContent = `抓取 (${i+1}/${selectedCbs.length})...`;

                    let page = 1, hasNext = true;
                    while (hasNext && page <= 50) {
                        const dRes = await mufyGet(`${API_BASE}/api/dialogs/query?sessionId=${sid}&characterId=${currentCharId}&pageNum=${page}&pageSize=200`);
                        if (dRes?.code === 200 && dRes.data?.data) {
                            const rows = dRes.data.data;
                            allDialogs.push(...rows);
                            hasNext = dRes.data.hasNext;
                            page++;
                        } else {
                            break;
                        }
                        await sleep(200);
                    }
                }

                if (allDialogs.length === 0) throw new Error('未抓取到任何对话内容。');

                // 按时间排序
                allDialogs.sort((a, b) => new Date(a.createdTime || 0) - new Date(b.createdTime || 0));

                if (format === 'json') {
                    const jsonData = {
                        _mufy_backup: true,
                        character: { id: currentCharId, name: charName },
                        mask: { name: maskName, bindInfo: maskBind },
                        dialogs: allDialogs
                    };
                    const blob = new Blob([JSON.stringify(jsonData, null, 2)], { type: 'application/json' });
                    triggerDownload(blob, `Mufy_快照_${charName}_${new Date().toLocaleDateString('zh-CN').replace(/\//g, '-')}.json`);
                } else {
                    exportMdBtn.textContent = '清洗排版中...';
                    let md = `# ${charName} · 剧情记录\n\n`;
                    md += `- **导出时间**：${new Date().toLocaleString('zh-CN')}\n`;
                    md += `- **使用面具**：${maskName}\n`;
                    md += `- **包含存档**：${selectedCbs.length} 个\n`;
                    if (isPure) md += `- **已开启清洗**：状态栏、HTML代码已被过滤\n`;
                    md += `\n---\n\n`;

                    allDialogs.forEach(msg => {
                        const isUser = msg.role === 'user';
                        const who = isUser ? ' 我' : ` ${charName}`;
                        const time = msg.createdTime ? new Date(msg.createdTime).toLocaleString('zh-CN') : '';

                        let text = contentToText(msg.content);
                        if (isPure) text = extractPureText(text);
                        if (!text.trim()) return;

                        md += `**${who}** <sub>${time}</sub>\n\n${text}\n\n`;
                    });

                    const blob = new Blob([md], { type: 'text/markdown;charset=utf-8' });
                    triggerDownload(blob, `${charName}_剧情_${new Date().toLocaleDateString('zh-CN').replace(/\//g, '-')}.md`);
                }
            } catch (err) {
                alert('导出失败: ' + err.message);
            } finally {
                exportMdBtn.disabled = false; exportJsonBtn.disabled = false;
                exportMdBtn.textContent = '导出 Markdown';
            }
        }

        exportMdBtn.addEventListener('click', () => doExport('md'));
        exportJsonBtn.addEventListener('click', () => doExport('json'));

                // 辅助下载函数（防拦截、防闪断版）
        function triggerDownload(blob, filename) {
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            a.style.display = 'none';

            // ★ 必须挂载到 body 上，否则部分浏览器不触发
            document.body.appendChild(a);
            a.click();

            // ★ 延迟清理，给浏览器留出把文件写进磁盘的时间
            setTimeout(() => {
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            }, 2000);
        }
    }
    // ============ 纯文本提取============
    function extractPureText(htmlString) {
        if (!htmlString) return '';
        try {
            const parser = new DOMParser();
            const doc = parser.parseFromString(htmlString, 'text/html');

            // 1. 删掉所有状态栏、思维链等标签
            const tagsToRemove = ['details', 'style', 'script', 'think', 'hypo'];
            tagsToRemove.forEach(tag => {
                doc.querySelectorAll(tag).forEach(el => el.remove());
            });

            // 2. 删掉带 clean 样式的包裹层
            const classesToRemove = ['a-clean', 'b-clean', 'a-status', 'status-bar'];
            classesToRemove.forEach(cls => {
                doc.querySelectorAll('.' + cls).forEach(el => el.remove());
            });

            // 3. 剥离 message 标签
            doc.querySelectorAll('message').forEach(el => {
                el.replaceWith(el.textContent);
            });

            let text = doc.body.innerText || doc.body.textContent || '';
            return text.replace(/\n{3,}/g, '\n\n').trim();
        } catch(e) {
            console.warn("正文清洗失败，退回原始文本", e);
            return htmlString;
        }
    }

    // 把接口返回的 content 数组转换成纯文本
    function contentToText(content) {
        if (typeof content === 'string') return content;
        if (!Array.isArray(content)) return content == null ? '' : JSON.stringify(content);
        return content
            .map((part) => {
                if (part == null) return '';
                if (typeof part === 'string') return part;
                if (part.type === 'text' || typeof part.text === 'string') return part.text || '';
                return JSON.stringify(part);
            })
            .join('\n');
    }
    function renderContent(contentEl) {
        const isAuthor = state.activeTab === 'author';
        let data = isAuthor ? state.authors : state.roles;
        if (!state.isScanning && state.searchQuery) {
    const p = state.searchParsed || parseSearchToken(state.searchQuery);
    const q = (p.q || p.raw || '').toLowerCase();

    data = data.filter(item => {
        // 精确 ID 命中
        if (p.type === 'id' || p.type === 'roleId') {
            return isSameId(item.characterId, p.id) ||
                   (isAuthor && isSameId(item.id, p.id));
        }
        if (p.type === 'authorId') {
            return isAuthor ? isSameId(item.id, p.id)
                            : isSameId(item.authorId, p.id);
        }
        if (p.type === 'shareCode') {
            return false; // 由外部解析，不在列表里匹配
        }
        // 关键词模糊
        if (isAuthor) {
            return String(item.name).toLowerCase().includes(q) ||
                   String(item.id).toLowerCase().includes(q);
        }
        return String(item.name).toLowerCase().includes(q) ||
               String(item.characterId).toLowerCase().includes(q) ||
               String(item.authorName || '').toLowerCase().includes(q) ||
               String(item.authorId || '').toLowerCase().includes(q);
    });

    // shareCode / roleUrl 这类需要额外解析的，走单点查询
    if ((p.type === 'shareCode' || p.type === 'roleUrl') && !data.length) {
        // 自动把输入丢进顶部单点查询框并触发
        singleInput.value = p.raw;
        singleBtn.click();
        return;
    }
}
        if (!data.length) { contentEl.innerHTML = `<div class="mufy-empty">${state.searchQuery ? '没有找到匹配的条目' : '暂无数据'}</div>`; return; }
        contentEl.innerHTML = data.slice(0, MAX_RENDER_COUNT).map((item, index) => {
            const rank = state.isScanning ? `#${index + 1}` : (index < 3 ? `0${index + 1}` : `#${index + 1}`);
            const isTop = index === 0 && !state.isScanning;
            if (isAuthor) {
                const subParts = [];
                if (item.isScanning) subParts.push(`<span style="color:#ccc;">读取中...</span>`);
                else if (!item.hasScanned) subParts.push(`<span style="color:#666;">排队中...</span>`);
                else {
                    if (item.id === 'unknown') subParts.push(`<span style="color:#888;">已失效的赛博亡魂</span>`);
                    else {
                        if (item.level > 0) subParts.push(`等级 ${item.level}`);
                        if (item.cards > 0) subParts.push(`主页卡数 ${item.cards}`);
                        subParts.push(`<span class="mufy-hl">你聊过 TA 的 ${item.rolesCount} 个角色</span>`);
                    }
                }
                const isExpanded = state.expandedAuthors.has(item.id);
                let subListHtml = '';
                if (isExpanded) {
                    const subRoles = state.roles.filter(r => (r.authorId || 'unknown') === item.id);
                    const sortedSubRoles = [...subRoles].sort((a,b) => (b.rounds || 0) - (a.rounds || 0));
                    const exploreBtn = `<div class="mufy-explore-wrap"><a href="https://chat.mufy.ai/profile/role?id=${item.id}" target="_blank" class="mufy-explore-btn">去看看 TA 主页还有哪些卡</a></div>`;
                    if (sortedSubRoles.length > 0) {
                        subListHtml = `<div class="mufy-sub-list">${sortedSubRoles.map(r => {
                            let s = '';
                            if (r.isScanning) s = '读取中...';
                            else if (!r.hasScanned) s = '排队中';
                            else if (r.rounds > 0) s = `${r.rounds} 轮`;
                            else if (r.isExpired) s = '你两见过，没嫖过，你也嫖不了了';
                            else s = '未评论';
                            return `<a href="https://chat.mufy.ai/chat?roleId=${r.characterId}" target="_blank" class="mufy-sub-item"><div class="mufy-sub-name">— ${esc(r.name)}</div><div class="mufy-sub-rounds ${r.rounds > 0 ? 'has-rounds' : (r.isExpired ? 'is-dead' : '')}">${s}</div></a>`;
                        }).join('')}${item.id !== 'unknown' ? exploreBtn : ''}</div>`;
                    } else {
                        subListHtml = `<div class="mufy-sub-list"><div class="mufy-sub-empty">暂无可展示的卡</div>${item.id !== 'unknown' ? exploreBtn : ''}</div>`;
                    }
                }
                let sT = '', sC = '';
                if (item.isScanning) { sT = '读取中...'; sC = 'is-loading'; }
                else if (!item.hasScanned) { sT = '排队中'; sC = 'is-pending'; }
                else { sT = item.totalRounds > 0 ? `${item.totalRounds}` : '-'; sC = item.totalRounds > 0 ? 'is-done' : 'is-empty'; }
                return `<div class="mufy-row-wrap">
                    <div class="mufy-row mufy-author-toggle ${isTop ? 'is-top' : ''}" data-id="${item.id}">
                      <div class="mufy-row-left">
                        <span class="mufy-rank">${rank}</span>
                        <div class="mufy-avatar-wrap">${item.avatarUrl ? `<img src="${esc(item.avatarUrl)}" class="mufy-avatar">` : `<div class="mufy-avatar-placeholder"></div>`}</div>
                        <div class="mufy-info"><div class="mufy-name">${esc(item.name)} ${isExpanded ? '收起' : '展开'}</div><div class="mufy-sub-text">${subParts.join(' · ')}</div></div>
                      </div>
                      <div class="mufy-row-right"><span class="mufy-score ${sC}">${sT}</span><span class="mufy-score-unit">${item.totalRounds > 0 || item.isScanning || !item.hasScanned ? '轮' : ''}</span></div>
                    </div>${subListHtml}</div>`;
            }
            let sT = '', sC = '', aT = item.authorName || '未知作者';
            if (item.isScanning) { sT = '读取中...'; sC = 'is-loading'; }
            else if (item.rounds > 0) { sT = `${item.rounds}`; sC = 'is-done'; }
            else if (!state.myUserId) { sT = '缺账号信息'; sC = 'is-err'; }
            else if (!item.hasScanned) { sT = '排队中'; sC = 'is-pending'; }
            else if (item.isExpired && item.rounds === 0) { sT = '未遂'; sC = 'is-err'; aT = '你两见过，没嫖过，你也嫖不了了'; }
            else if (item.hasCommented) { sT = '无轮数'; sC = 'is-empty'; }
            else { sT = '未评论'; sC = 'is-empty'; }

            // 单角色重扫按钮
            return `<div class="mufy-row-wrap mufy-link" style="display:flex; align-items:center;">
                <a href="https://chat.mufy.ai/chat?roleId=${item.characterId}" target="_blank" style="flex:1; text-decoration:none; color:inherit;">
                    <div class="mufy-row ${isTop ? 'is-top' : ''}">
                      <div class="mufy-row-left"><span class="mufy-rank">${rank}</span><div class="mufy-info"><div class="mufy-name">${esc(item.name)}</div><div class="mufy-sub-text ${item.isExpired && item.rounds === 0 ? 'text-danger' : ''}">${esc(aT)}</div></div></div>
                      <div class="mufy-row-right"><span class="mufy-score ${sC}">${sT}</span><span class="mufy-score-unit">${item.rounds > 0 ? '轮' : ''}</span></div>
                    </div>
                </a>
                <button class="mufy-refresh-btn" data-cid="${item.characterId}" title="单独重新扫描此角色的轮数" style="background:transparent; border:none; color:#888; cursor:pointer; font-size:11px; padding:8px; text-decoration:underline;">刷新</button>
            </div>`;
        }).join('');
        if (data.length > MAX_RENDER_COUNT) {
            contentEl.innerHTML += `<div style="text-align: center; color: #666; padding: 20px; font-size: 12px;">仅展示了前 ${MAX_RENDER_COUNT} 条数据，共有 ${data.length} 条。</div>`;
        }
    }

    // ============ ★ 账号管理与多开签到 ★ ============
    const ACCOUNTS_KEY = 'mufy_saved_accounts_v1';

    function getSavedAccounts() {
        try {
            return JSON.parse(localStorage.getItem(ACCOUNTS_KEY) || '[]');
        } catch (e) { return []; }
    }

    function saveSavedAccounts(accounts) {
        localStorage.setItem(ACCOUNTS_KEY, JSON.stringify(accounts));
}

          function renderAccountsTab(contentEl, setStatus) {
        const accounts = getSavedAccounts();
state.accounts = accounts;
        let localToken = localStorage.getItem('mufy-token') || localStorage.getItem('token') || localStorage.getItem('mufy_token') || '';
        const currentToken = localToken.replace(/^Bearer\s+/i, '');

        let html = `
          <div style="padding: 10px; font-size: 13px; color: #aaa; line-height: 1.6;">
            <div style="font-size: 14px; color: #fff; margin-bottom: 8px;">账号管理</div>
            <div style="margin-bottom: 12px; color: #666;">利用官方登录接口实现丝滑切号与全签。</div>

            <!-- 账号密码登录 -->
            <div style="margin-bottom: 16px; padding:12px; background:#0a0a0a; border:1px solid #222; border-radius:8px;">
                <div style="font-size:12px; color:#888; margin-bottom:8px;">通过账号密码登录并保存（推荐）</div>
                <div style="display:flex; gap:8px; flex-direction:column;">
                    <input type="text" id="mufy-acc-email" class="mufy-input" placeholder="邮箱 / 账号" style="width:100%; padding:8px; background:#000; border:1px solid #333; border-radius:4px; color:#fff;">
                    <input type="password" id="mufy-acc-pwd" class="mufy-input" placeholder="密码" style="width:100%; padding:8px; background:#000; border:1px solid #333; border-radius:4px; color:#fff;">
                    <button class="mufy-btn" id="mufy-acc-login-save" style="width:100%; height:36px; background:#222; color:#ccc; border:1px solid #444;">登录并保存</button>
                </div>
                <div style="font-size:11px; color:#ffb74d; margin-top:8px;">⚠️ 密码以明文保存在本地。</div>
            </div>

            <div style="display:flex; gap:8px; margin-bottom: 16px;">
                <button class="mufy-btn" id="mufy-acc-save" style="flex:1; height:36px; background:#fff; color:#000;">仅保存当前号(无密码)</button>
                <button class="mufy-btn" id="mufy-acc-sign-all" style="flex:1; height:36px; background:#222; color:#ccc; border:1px solid #444;">一键全签</button>
            </div>

            <div id="mufy-acc-status" style="font-size:12px; color:#888; margin-bottom:12px; text-align:center;"></div>

            <div style="background:#0a0a0a; border:1px solid #222; border-radius:8px; overflow:hidden;">
                ${accounts.length === 0 ? '<div style="padding:16px; text-align:center; color:#555;">暂无保存的账号</div>' :
                accounts.map((acc, idx) => {
                    const isCurrent = acc.token === currentToken;
                    return `
                    <div style="display:flex; justify-content:space-between; align-items:center; padding:12px; border-bottom:1px solid #1a1a1a;">
                        <div style="flex:1;">
                            <div style="color:#ccc; font-size:13px; margin-bottom:2px;">${esc(acc.name)} ${isCurrent ? '<span style="color:#666;font-size:11px;">(当前)</span>' : ''}</div>
                            <div style="color:#444; font-size:11px;">Token: ${acc.token.slice(0, 10)}...</div>
                            <div id="mufy-acc-info-${idx}" style="color:#888; font-size:11px; margin-top:4px;">查询中...</div>
                        </div>
                        <div style="display:flex; gap:6px; flex-direction:column; margin-left:10px;">
                            <button class="mufy-folder-btn" data-acc-ledger="${idx}" style="color:#aaa; border-color:#333;">账本</button>
                            ${!isCurrent && acc.password ? `<button class="mufy-folder-btn" data-acc-switch="${idx}" style="color:#4caf50; border-color:#2e7d32;">一键切号</button>` : ''}
                            ${acc.password ? `<button class="mufy-folder-btn" data-acc-refresh="${idx}" style="color:#00bcd4; border-color:#006064;">刷新Token</button>` : ''}
                            <button class="mufy-folder-btn" data-acc-del="${idx}" style="color:#ff5252; border-color:#5a1f1f;">删除</button>
                        </div>
                    </div>`;
                }).join('')}
            </div>
          </div>
        `;
        contentEl.innerHTML = html;

        const saveBtn = contentEl.querySelector('#mufy-acc-save');
        const signAllBtn = contentEl.querySelector('#mufy-acc-sign-all');
        const statusEl = contentEl.querySelector('#mufy-acc-status');
        const emailInput = contentEl.querySelector('#mufy-acc-email');
        const pwdInput = contentEl.querySelector('#mufy-acc-pwd');
        const loginSaveBtn = contentEl.querySelector('#mufy-acc-login-save');

        async function rawAccountFetch(url, token, method = 'GET', body = null) {
            const headers = { 'Accept': 'application/json', 'Authorization': `Bearer ${token}`, 'Origin': 'https://chat.mufy.ai', 'Referer': 'https://chat.mufy.ai/' };
            const options = { method, headers, credentials: 'include' };
            if (method === 'POST' && body) { headers['Content-Type'] = 'application/json'; options.body = JSON.stringify(body); }
            const res = await fetch(url, options);
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            return await res.json();
        }

        async function doLoginAndSave(email, password) {
            const res = await fetch(`${API_BASE}/api/users/login`, {
                method: 'POST',
                headers: { 'Accept': 'application/json', 'Content-Type': 'application/json', 'Origin': 'https://chat.mufy.ai', 'Referer': 'https://chat.mufy.ai/login' },
                body: JSON.stringify({ email, password })
            });
            const json = await res.json();
            if (json.code === 200 && json.data?.token) return json.data.token;
            throw new Error(json.reason || '登录失败');
        }



        async function fetchAccountInfo() {
            for (let i = 0; i < accounts.length; i++) {
                const acc = accounts[i];
                const domEl = contentEl.querySelector(`#mufy-acc-info-${i}`);
                if (!domEl) continue;

                try {
                    let info;

                    try {
                        // 先使用现有 Token
                        info = await rawAccountFetch(
                            `${API_BASE}/api/users/current`,
                            acc.token
                        );
                    } catch (e) {
                        // 只有 401 才自动刷新
                        if (!String(e.message).includes('401')) throw e;

                        if (!acc.email || !acc.password) {
                            throw new Error('Token失效，账号未保存密码');
                        }

                        domEl.innerHTML = '<span style="color:#00bcd4;">Token过期，自动刷新中...</span>';

                        // 登录获取新 Token
                        const newToken = await doLoginAndSave(acc.email, acc.password);

                        // 更新账号数据
                        acc.token = newToken;
                        accounts[i] = acc;
                        state.accounts = accounts;
                        saveSavedAccounts(accounts);

                        // 使用新 Token 再查询一次
                        info = await rawAccountFetch(
                            `${API_BASE}/api/users/current`,
                            newToken
                        );
                    }

                    if (info.code === 200 && info.data) {
                        const d = info.data;
                        const total = d.totalGem ? d.totalGem.toFixed(2) : '0.00';
                        const hasSigned = d.needCheckIn === false;

                        domEl.innerHTML = `
                            <span style="color:#fff;">${total} 总资产</span><br>
                            <span style="color:${hasSigned ? '#aaa' : '#555'};">
                                ${hasSigned ? '今日已签' : '今日未签'}
                            </span>
                        `;
                    } else {
                        domEl.innerHTML = `<span style="color:#ffb74d;">数据异常：${esc(String(info.reason || info.code || '未知错误'))}</span>`;
                    }

                } catch (e) {
                    console.warn('[Mufy账号检测失败]', acc.name, e);
                    domEl.innerHTML = `<span style="color:#ff5252;">${esc(String(e.message || e))}</span>`;
                }

                await sleep(200);
            }
        }



        if (accounts.length > 0) fetchAccountInfo();

        loginSaveBtn.addEventListener('click', async () => {
            const email = emailInput.value.trim();
            const password = pwdInput.value.trim();
            if (!email || !password) return alert('请输入账号和密码');
            loginSaveBtn.disabled = true; loginSaveBtn.textContent = '登录中...';
            try {
                const token = await doLoginAndSave(email, password);
                const newAccounts = accounts.filter(a => a.name !== email && a.token !== token);
                newAccounts.push({ name: email, token, email: email, password: password });
                state.accounts = newAccounts;
                saveSavedAccounts(newAccounts);
                alert('登录成功并保存！');
                renderAccountsTab(contentEl, setStatus);
            } catch (e) { alert('登录失败：' + e.message); }
            finally { loginSaveBtn.disabled = false; loginSaveBtn.textContent = '登录并保存'; }
        });

        saveBtn.addEventListener('click', () => {
            if (!localToken) return alert('未检测到当前账号 Token');
            const token = localToken.replace(/^Bearer\s+/i, '');
            const name = prompt('给这个账号起个名字：', '账号 ' + (accounts.length + 1));
            if (!name) return;
            const newAccounts = accounts.filter(a => a.token !== token);
            newAccounts.push({ name, token });
            state.accounts = newAccounts;
            saveSavedAccounts(newAccounts);
            renderAccountsTab(contentEl, setStatus);
        });

              signAllBtn.addEventListener('click', async () => {
            if (accounts.length === 0) return alert('没有保存的账号');
            if (!confirm('将依次为所有账号进行真实签到，是否继续？')) return;

            signAllBtn.disabled = true;
            signAllBtn.textContent = '签到中...';
            statusEl.innerHTML = '准备开始...';

            let newSignCount = 0; // 这次新签到的数量
            let alreadySignedCount = 0; // 之前已经签过的数量
            let failCount = 0; // 失败数量

            for (let i = 0; i < accounts.length; i++) {
                const acc = accounts[i];
                statusEl.innerHTML = `正在处理账号 [${i+1}/${accounts.length}]：${acc.name}...`;

                try {
                    // 1. 先获取账号最新状态，看看今天签了没
                    const info = await rawAccountFetch(`${API_BASE}/api/users/current`, acc.token);
                    if (info.code !== 200 || !info.data) throw new Error('获取账号信息失败');

                    let total = info.data.totalGem ? info.data.totalGem.toFixed(2) : '0.00';
                    let hasSigned = (info.data.needCheckIn === false);

                    // 2. 如果还没签，发送真实的签到请求
                    if (!hasSigned) {
                        statusEl.innerHTML += ` <span style="color:#00bcd4;">(签到中...)</span>`;

                        // 发送 POST 请求到签到接口
                        const checkinRes = await fetch(`${API_BASE}/api/users/checkin`, {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json, text/plain, */*',
                                'Authorization': `Bearer ${acc.token}`,
                                'Origin': 'https://chat.mufy.ai',
                                'Referer': 'https://chat.mufy.ai/'
                            },
                            credentials: 'include'
                        });

                        if (checkinRes.status === 401) throw new Error("Token已过期(被踢)");
                        const checkinData = await checkinRes.json();

                        if (checkinData.code === 200) {
                            // 签到成功，拿到奖励数字（虽然前端不一定要用）
                            const reward = checkinData.data?.freeGemAmount || 0;
                            newSignCount++;
                            statusEl.innerHTML += ` <span style="color:#4caf50;">成功 (+${reward})</span>`;

                            // 签到成功后，再查一次最新资产，更新到界面上
                            const newInfo = await rawAccountFetch(`${API_BASE}/api/users/current`, acc.token);
                            if (newInfo.code === 200 && newInfo.data) {
                                total = newInfo.data.totalGem ? newInfo.data.totalGem.toFixed(2) : total;
                                hasSigned = true; // 标记为已签
                            }
                        } else {
                            throw new Error(checkinData.reason || '签到接口报错');
                        }
                    } else {
                        // 已经签过了，直接跳过
                        alreadySignedCount++;
                        statusEl.innerHTML += ` <span style="color:#888;">(今日已签，跳过)</span>`;
                    }

                    // 3. 更新这一行账号的 UI 显示
                    const infoEl = contentEl.querySelector(`#mufy-acc-info-${i}`);
                    if (infoEl) {
                        infoEl.innerHTML = `
                            <span style="color:#fff;">${total} 总资产</span><br>
                            <span style="color:${hasSigned ? '#aaa' : '#555'};">
                                ${hasSigned ? '今日已签' : '今日未签'}
                            </span>
                        `;
                    }

                } catch (e) {
                    failCount++;
                    statusEl.innerHTML += ` <span style="color:#ff5252;">(失败: ${e.message})</span>`;
                    console.warn(`[签到失败] ${acc.name}`, e);
                }

                // 稍微停顿一下，避免请求过快被服务器拦截
                await sleep(1000);
            }

            signAllBtn.textContent = '一键全签';
            signAllBtn.disabled = false;
            statusEl.innerHTML = `全签完毕！✨<br>新签到: <span style="color:#4caf50;">${newSignCount}</span> 个，已签跳过: <span style="color:#aaa;">${alreadySignedCount}</span> 个，失败: <span style="color:#ff5252;">${failCount}</span> 个`;
        });
               // 4. 一键切号（打标记自愈版）
        contentEl.querySelectorAll('[data-acc-switch]').forEach(btn => {
            btn.addEventListener('click', async () => {
                const idx = btn.getAttribute('data-acc-switch');
                const acc = accounts[idx];
                if (!confirm(`确定自动登录并切换到「${acc.name}」吗？`)) return;

                btn.disabled = true; btn.textContent = '切号中...';
                try {
                    const res = await fetch('https://chat.mufy.ai/api/users/login', {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json, text/plain, */*',
                            'Content-Type': 'application/json',
                            'Origin': 'https://chat.mufy.ai',
                            'Referer': 'https://chat.mufy.ai/login'
                        },
                        body: JSON.stringify({ email: acc.email, password: acc.password })
                    });
                    const json = await res.json();
                    if (json.code !== 200 || !json.data?.token) throw new Error(json.reason || '登录失败');

                    const newToken = json.data.token;
                    const newAccounts = [...accounts];
                    newAccounts[idx].token = newToken;
                    state.accounts = newAccounts;
                    saveSavedAccounts(newAccounts);

                    localStorage.setItem('mufy-token', newToken);
                    localStorage.setItem('token', newToken);
                    localStorage.removeItem('mufy-store');
                    capturedAuth = `Bearer ${newToken}`;

                    // ★ 核心：打个标记，告诉下一次页面加载“我是刚切号过来的”
                    localStorage.setItem('mufy_just_switched', 'true');

                    window.location.replace('https://chat.mufy.ai/');
                } catch (e) {
                    alert('自动登录切换失败：' + e.message);
                    btn.disabled = false; btn.textContent = '一键切号';
                }
            });
        });

        // 5. 刷新 Token
        contentEl.querySelectorAll('[data-acc-refresh]').forEach(btn => {
            btn.addEventListener('click', async () => {
                const idx = btn.getAttribute('data-acc-refresh');
                const acc = accounts[idx];
                btn.disabled = true; btn.textContent = '请求中...';
                try {
                    const newToken = await doLoginAndSave(acc.email, acc.password);
                    const newAccounts = [...accounts];
                    newAccounts[idx].token = newToken;
                    state.accounts = newAccounts;
                    saveSavedAccounts(newAccounts);

                    if (acc.token === currentToken) {
                        localStorage.setItem('mufy-token', newToken);
                        localStorage.setItem('token', newToken);
                        localStorage.removeItem('mufy-store'); // 顺手清一下
                        capturedAuth = `Bearer ${newToken}`;
                        alert('当前号 Token 已刷新！即将刷新页面应用新 Token。');
                        window.location.reload();
                    } else {
                        alert(`账号「${acc.name}」Token 已更新为最新！`);
                        renderAccountsTab(contentEl, setStatus);
                    }
                } catch (e) {
                    alert('刷新失败：' + e.message);
                    btn.disabled = false; btn.textContent = '刷新Token';
                }
            });
        });

        // 6. 删除
        contentEl.querySelectorAll('[data-acc-del]').forEach(btn => {
            btn.addEventListener('click', () => {
                const idx = btn.getAttribute('data-acc-del');
                if (confirm('确定删除此账号记录吗？')) {
                    const newAccounts = [...accounts];
                    newAccounts.splice(idx, 1);
                    state.accounts = newAccounts;
                    saveSavedAccounts(newAccounts);
                    renderAccountsTab(contentEl, setStatus);
                }
            });
        });

        // 7. 赛博账本
        contentEl.querySelectorAll('[data-acc-ledger]').forEach(btn => {
            btn.addEventListener('click', async () => {
                const idx = btn.getAttribute('data-acc-ledger');
                const acc = accounts[idx];

                const overlay = document.createElement('div');
                overlay.className = 'mufy-mask-overlay';
                overlay.innerHTML = `
                  <div class="mufy-mask-picker" style="width: 520px; max-height: 85vh;">
                    <div class="mufy-mask-picker-header">
                      <div class="mufy-mask-picker-title">账本 · ${esc(acc.name)}</div>
                      <button class="mufy-mask-picker-close">×</button>
                    </div>
                    <div style="padding: 16px; overflow-y: auto;">
                        <div id="mufy-ledger-loading" style="text-align:center; color:#666; padding:20px;">正在翻阅流水 (最多10页)...</div>

                        <div id="mufy-ledger-content" style="display:none;">
                            <div style="margin-bottom: 20px; background:#0a0a0a; border-radius:8px; padding:12px; border:1px solid #222;">
                                <div style="font-size:13px; color:#fff; margin-bottom:10px;">今日账本 (04:00 刷新)</div>
                                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; font-size:12px;">
                                    <div style="color:#aaa;">猫粮消耗: <span id="today-catFood">0</span></div>
                                    <div style="color:#aaa;">罐头消耗: <span id="today-can">0</span></div>
                                    <div style="color:#fff; font-weight:500;">评论打赏: <span id="today-tip">0</span></div>
                                    <div style="color:#888;">鱼干返利: <span id="today-rebate">0</span></div>
                                    <div style="color:#888;">其他赚取: <span id="today-earn">0</span></div>
                                </div>
                            </div>

                            <div style="margin-bottom: 20px; background:#0a0a0a; border-radius:8px; padding:12px; border:1px solid #222;">
                                <div style="font-size:13px; color:#fff; margin-bottom:10px;">累积账本 <span style="font-size:11px; color:#444;">(最近10页内)</span></div>
                                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; font-size:12px;">
                                    <div style="color:#aaa;">猫粮消耗: <span id="all-catFood">0</span></div>
                                    <div style="color:#aaa;">罐头消耗: <span id="all-can">0</span></div>
                                    <div style="color:#fff; font-weight:500;">评论打赏: <span id="all-tip">0</span></div>
                                    <div style="color:#888;">鱼干返利: <span id="all-rebate">0</span></div>
                                    <div style="color:#888;">其他赚取: <span id="all-earn">0</span></div>
                                </div>
                            </div>

                            <div style="font-size:12px; color:#aaa; margin-bottom:8px;">最近流水明细：</div>
                            <div id="mufy-ledger-list" style="display:flex; flex-direction:column; gap:6px; font-size:11px;"></div>
                        </div>
                    </div>
                  </div>`;
                document.body.appendChild(overlay);

                const close = () => overlay.remove();
                overlay.querySelector('.mufy-mask-picker-close').addEventListener('click', close);
                overlay.addEventListener('click', e => { if (e.target === overlay) close(); });

                const loadingEl = overlay.querySelector('#mufy-ledger-loading');
                const ledgerContent = overlay.querySelector('#mufy-ledger-content');
                const listEl = overlay.querySelector('#mufy-ledger-list');

                let allRecords = [];
                let page = 1;
                const MAX_PAGES = 10;

                try {
                    while (page <= MAX_PAGES) {
                        const res = await rawAccountFetch(`${API_BASE}/api/transactions/history`, acc.token, 'POST', { pageNum: page, pageSize: 100 });
                        const list = res?.data?.data || [];
                        if (list.length === 0) break;
                        allRecords.push(...list);
                        if (!res?.data?.hasNext) break;
                        page++;
                        await sleep(300);
                    }

                    const now = new Date();
                    let today4am = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 4, 0, 0);
                    if (now < today4am) today4am.setDate(today4am.getDate() - 1);

                    let today = { catFood: 0, can: 0, tip: 0, rebate: 0, earn: 0 };
                    let all = { catFood: 0, can: 0, tip: 0, rebate: 0, earn: 0 };

                    allRecords.forEach(item => {
                        const itemDate = new Date(item.createdAt.replace(/-/g, '/'));
                        const isToday = itemDate >= today4am;

                        const amount = Number(item.amount);
                        const isSpend = amount < 0;
                        const absAmount = Math.abs(amount);

                        let category = '';
                        if (item.type === 1) {
                            category = 'catFood';
                        } else if (item.type === 2) {
                            if (item.description.includes('打赏') || item.description.includes('投喂') || item.description.includes('置顶')) {
                                category = 'tip';
                            } else {
                                category = 'can';
                            }
                        } else if (item.type === 3) {
                            category = 'rebate';
                        } else {
                            category = 'earn';
                        }

                        if (isSpend) {
                            if (category === 'catFood') all.catFood += absAmount;
                            else if (category === 'can') all.can += absAmount;
                            else if (category === 'tip') all.tip += absAmount;
                            else all.earn -= absAmount;
                        } else {
                            if (category === 'rebate') all.rebate += amount;
                            else all.earn += amount;
                        }

                        if (isToday) {
                            if (isSpend) {
                                if (category === 'catFood') today.catFood += absAmount;
                                else if (category === 'can') today.can += absAmount;
                                else if (category === 'tip') today.tip += absAmount;
                                else today.earn -= absAmount;
                            } else {
                                if (category === 'rebate') today.rebate += amount;
                                else today.earn += amount;
                            }
                        }

                        let color = isSpend ? '#888' : '#555';
                        let prefix = isSpend ? '-' : '+';
                        let bg = category === 'tip' ? '#1a1a1a' : 'transparent';

                        let typeLabel = '';
                        if (category === 'catFood') typeLabel = '猫粮';
                        else if (category === 'can') typeLabel = '罐头';
                        else if (category === 'tip') typeLabel = '打赏';
                        else if (category === 'rebate') typeLabel = '鱼干';

                        listEl.insertAdjacentHTML('beforeend', `
                            <div style="display:flex; justify-content:space-between; padding:6px; background:${bg}; border-radius:4px; border-bottom:1px solid #1c1c1c;">
                                <div style="color:#666;">${item.createdAt.slice(5, 16)} <span style="color:#444;">| ${esc(item.description)}</span></div>
                                <div style="color:${color}; font-family:monospace;">${prefix}${absAmount} <span style="color:#444; font-size:10px;">(${typeLabel})</span></div>
                            </div>
                        `);
                    });

                    overlay.querySelector('#today-catFood').textContent = today.catFood;
                    overlay.querySelector('#today-can').textContent = today.can;
                    overlay.querySelector('#today-tip').textContent = today.tip;
                    overlay.querySelector('#today-rebate').textContent = today.rebate;
                    overlay.querySelector('#today-earn').textContent = today.earn;

                    overlay.querySelector('#all-catFood').textContent = all.catFood;
                    overlay.querySelector('#all-can').textContent = all.can;
                    overlay.querySelector('#all-tip').textContent = all.tip;
                    overlay.querySelector('#all-rebate').textContent = all.rebate;
                    overlay.querySelector('#all-earn').textContent = all.earn;

                    loadingEl.style.display = 'none';
                    ledgerContent.style.display = 'block';

                } catch (e) {
                    loadingEl.innerHTML = `<span style="color:#ff5252;">拉取流水失败: ${e.message}</span>`;
                }
            });
        });
}
               function mount() {
        // ★★★ 究极自愈：仅当刚刚切号后触发，平时绝对静默 ★★★
        if (localStorage.getItem('mufy_just_switched') === 'true') {
            localStorage.removeItem('mufy_just_switched');

            // 延迟 2.5 秒，等前端把该作的妖作完
            setTimeout(async () => {
                const token = (localStorage.getItem('mufy-token') || localStorage.getItem('token') || '').replace(/^Bearer\s+/i, '');
                const saved = JSON.parse(localStorage.getItem('mufy_saved_accounts_v1') || '[]');
                const acc = saved.find(a => a.token === token);

                if (acc && acc.email && acc.password) {
                    console.log(`[自愈] 发现刚刚切号，正在后台为您自动刷新 ${acc.name} 的 Token...`);
                    try {
                        const res = await fetch('https://chat.mufy.ai/api/users/login', {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json, text/plain, */*',
                                'Content-Type': 'application/json',
                                'Origin': 'https://chat.mufy.ai',
                                'Referer': 'https://chat.mufy.ai/login'
                            },
                            body: JSON.stringify({ email: acc.email, password: acc.password })
                        });
                        const json = await res.json();
                        if (json.code === 200 && json.data?.token) {
                            const newToken = json.data.token;

                            // 1. 写入网页 LocalStorage
                            localStorage.setItem('mufy-token', newToken);
                            localStorage.setItem('token', newToken);
                            localStorage.removeItem('mufy-store');

                            // 2. 强行覆盖全局缓存（斩断旧号干扰）
                            capturedAuth = `Bearer ${newToken}`;

                            // 3. ★ 同步更新本地账号列表（GPT 指出的致命漏洞）
                            acc.token = newToken;
                            localStorage.setItem('mufy_saved_accounts_v1', JSON.stringify(saved));

                            console.log(`[自愈] 刷新成功，正在自动重载页面...`);

                            // 再刷一次，这次绝对稳
                            window.location.reload();
                        }
                    } catch (e) {
                        console.warn('[自愈] 自动刷新失败', e);
                    }
                }
            }, 2500);
        }

        if (document.getElementById('mufy-ar-root')) return;
        state.maskLibrary = loadMaskLibrary();

        const style = document.createElement('style');
        style.textContent = `
          :root{--bg-main:#050505;--bg-card:#121212;--bg-hover:#1e1e1e;--bg-sub:#0a0a0a;--text-main:#ededed;--text-sub:#888;--text-dark:#555;--border-color:#222;--accent:#fff}
          #mufy-ar-btn{position:fixed;z-index:2147483647!important;width:52px;height:52px;background:#111;color:#fff;border:1px solid var(--border-color);border-radius:50%;cursor:pointer;font-size:24px;box-shadow:0 10px 30px rgba(0,0,0,.8);display:flex;align-items:center;justify-content:center;pointer-events:auto!important;touch-action:none!important;transition:background .2s ease, transform .1s ease;}
          #mufy-scroll-ctrl { position: fixed; right: 16px; top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; gap: 10px; z-index: 2147483640; opacity: 0.3; transition: opacity 0.2s; }
          #mufy-scroll-ctrl:hover { opacity: 1; }
          #mufy-scroll-ctrl button { width: 36px; height: 36px; border-radius: 50%; background: rgba(20, 20, 20, 0.8); color: #fff; border: 1px solid #444; cursor: pointer; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(4px); transition: all 0.2s; padding: 0; }
          #mufy-scroll-ctrl button:hover { background: #fff; color: #000; border-color: #fff; transform: scale(1.1); }
          #mufy-scroll-ctrl svg { display: block; }
          #mufy-ar-btn:active{transform:scale(.95)}
          #mufy-ar-modal{display:none;position:fixed;z-index:2147483646!important;background:rgba(10,10,10,.95);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);color:var(--text-main);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,.9)}
