          .mufy-mask-input:focus{border-color:#555}
.mufy-tabs{
  display:flex;
  gap:16px;
  padding:0 20px;
  border-bottom:1px solid var(--border-color);
  margin-bottom:10px;
  overflow-x:auto;              /* 关键：横向滚动 */
  overflow-y:hidden;
  flex-wrap:nowrap;             /* 关键：绝不换行 */
  -webkit-overflow-scrolling:touch;
  scrollbar-width:none;         /* Firefox 隐藏滚动条 */
}
.mufy-tabs::-webkit-scrollbar{ display:none; }  /* Chrome 隐藏滚动条 */
.mufy-tab{
  background:transparent;border:none;color:var(--text-sub);
  font-size:13px;padding:8px 0;cursor:pointer;position:relative;
  font-weight:500;
  flex:0 0 auto;                /* 关键：不被压缩 */
  white-space:nowrap;
}
.mufy-tabs-wrap{
  position:relative;
}
.mufy-tabs-wrap::before,
.mufy-tabs-wrap::after{
  content:'';
  position:absolute;top:0;bottom:0;width:24px;
  pointer-events:none;z-index:2;
}
.mufy-tabs-wrap::before{ left:0;  background:linear-gradient(90deg,#050505,transparent); }
.mufy-tabs-wrap::after { right:0; background:linear-gradient(270deg,#050505,transparent); }
          #mufy-ar-modal.mufy-screenshot-mode .mufy-tools,#mufy-ar-modal.mufy-screenshot-mode .mufy-actions,#mufy-ar-modal.mufy-screenshot-mode .mufy-header-actions{display:none!important}
          #mufy-ar-modal.mufy-screenshot-mode .mufy-header{justify-content:center;text-align:center;padding-bottom:0}
          #mufy-ar-modal.mufy-screenshot-mode .mufy-tabs{justify-content:center;border-bottom:none;margin-bottom:15px;pointer-events:none}
          #mufy-ar-modal.mufy-screenshot-mode .mufy-tab.active::after{display:none}
          #mufy-exit-screenshot{display:none;position:absolute;top:12px;right:12px;z-index:2147483648;width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.2);cursor:pointer;font-size:16px;line-height:1;align-items:center;justify-content:center}
          #mufy-ar-modal.mufy-screenshot-mode #mufy-exit-screenshot{display:flex!important}
          #mufy-screenshot-btn{background:transparent;border:none;color:var(--text-sub);cursor:pointer;padding:0;display:flex;align-items:center;justify-content:center}
        `;
        document.documentElement.appendChild(style);

        // 1. 创建回顶回底按钮
        const scrollCtrl = document.createElement('div');
        scrollCtrl.id = 'mufy-scroll-ctrl';
        scrollCtrl.innerHTML = `
            <button id="mufy-scroll-top" title="回到顶部">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
            </button>
            <button id="mufy-scroll-bottom" title="回到底部">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
            </button>
        `;
        document.body.appendChild(scrollCtrl);

        // 2. 创建悬浮球（星星）
        const btn = document.createElement('button');
        btn.id = 'mufy-ar-btn';
        btn.innerHTML = '✦';
        document.body.appendChild(btn);

        // 3. 创建面板
        const modal = document.createElement('div');
        modal.id = 'mufy-ar-modal';
             modal.innerHTML = `
          <button id="mufy-exit-screenshot" title="退出截图模式">✕</button>
          <div class="mufy-header">
            <div class="mufy-header-text">
              <h2>Mufy Recap</h2>
              <p>马粪你毁了我一辈子啊</p>
            </div>
                       <div class="mufy-header-actions" style="display:flex;gap:12px;align-items:center;">
              <button id="mufy-toggle-scroll-btn" title="显示/隐藏快捷回顶回底">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 16V4m0 0L3 8m4-4l4 4m6 4v12m0 0l4-4m-4 4l-4-4"/></svg>
              </button>
              <button id="mufy-screenshot-btn" title="纯净截图模式">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
              </button>
              <button class="mufy-close" id="mufy-ar-close">×</button>
            </div>
          </div>
          <div class="mufy-tools">
            <div class="mufy-search-box">
              <input type="text" id="mufy-ar-single-input" class="mufy-input" placeholder="粘贴角色链接或 ID...">
              <button id="mufy-ar-single-btn" class="mufy-btn">查询</button>
            </div>
            <div id="mufy-ar-single-result" style="display:none;padding:12px;background:var(--bg-card);border-radius:8px;font-size:13px;border:1px solid var(--border-color);"></div>
          </div>
<div class="mufy-tabs-wrap">
          <div class="mufy-tabs">
            <button id="tab-role" class="mufy-tab active">角色</button>
            <button id="tab-author" class="mufy-tab">作者</button>
            <button id="tab-collection" class="mufy-tab">收藏</button>
            <button id="tab-masklib" class="mufy-tab">面具</button>
            <button id="tab-harvest" class="mufy-tab">主页</button>
<button id="tab-accounts" class="mufy-tab">账号</button>
<button id="tab-memo" class="mufy-tab">备忘</button>
<button id="tab-archive" class="mufy-tab">存档</button>
          </div>
</div>
                   <div class="mufy-actions">
             <div id="mufy-ar-status" class="mufy-status success">准备ok</div>
             <div style="display:flex;gap:8px; align-items:center;">
                <button id="mufy-ar-export" class="mufy-action-btn" style="padding:6px 8px; font-size:11px;">备份</button>
                <button id="mufy-ar-import" class="mufy-action-btn" style="padding:6px 8px; font-size:11px;">恢复</button>
                <button id="mufy-ar-clear" class="mufy-action-btn" style="padding:6px 8px; font-size:11px;">清缓存</button>
                <button id="mufy-ar-scan" class="mufy-action-btn primary">扫描</button>
             </div>
          </div>
          <input type="file" id="mufy-ar-import-file" accept=".json" style="display:none;">
          <div class="mufy-tools" style="padding-bottom:10px;">
             <input type="text" id="mufy-ar-search" class="mufy-input" style="background:var(--bg-card);border:1px solid var(--border-color);border-radius:8px;padding:8px 12px;" placeholder="在这里搜你想搜的东西吧...">
             <div id="mufy-ar-manual-wrap" style="display:none;margin-top:8px;font-size:12px;color:#fff;">
                <span style="color:#888;">手动填 ID:</span>
                <input type="text" id="mufy-ar-id-input" class="mufy-input" style="border:1px solid #333;border-radius:4px;padding:6px;width:160px;">
                <button id="mufy-ar-id-save" class="mufy-action-btn">保存</button>
             </div>
          </div>
          <div id="mufy-ar-content"></div>
        `;
        document.body.appendChild(modal);

        const statusEl = modal.querySelector('#mufy-ar-status');
        const contentEl = modal.querySelector('#mufy-ar-content');
        const tabAuthor = modal.querySelector('#tab-author');
        const tabRole = modal.querySelector('#tab-role');
        const tabCollection = modal.querySelector('#tab-collection');
        const tabMaskLib = modal.querySelector('#tab-masklib');
        const tabHarvest = modal.querySelector('#tab-harvest');
        const searchInput = modal.querySelector('#mufy-ar-search');
        const scanBtn = modal.querySelector('#mufy-ar-scan');
        const clearBtn = modal.querySelector('#mufy-ar-clear');
        const singleInput = modal.querySelector('#mufy-ar-single-input');
        const singleBtn = modal.querySelector('#mufy-ar-single-btn');
        const singleResultEl = modal.querySelector('#mufy-ar-single-result');
        const manualWrap = modal.querySelector('#mufy-ar-manual-wrap');
        const idInput = modal.querySelector('#mufy-ar-id-input');
        const idSaveBtn = modal.querySelector('#mufy-ar-id-save');
        const screenshotBtn = modal.querySelector('#mufy-screenshot-btn');
        const exitScreenshotBtn = modal.querySelector('#mufy-exit-screenshot');
const tabAccounts = modal.querySelector('#tab-accounts');
const tabMemo = modal.querySelector('#tab-memo');
const tabArchive = modal.querySelector('#tab-archive'); // 👈 加上这行

        // ================= 回顶回底开关逻辑 =================
        const toggleScrollBtn = modal.querySelector('#mufy-toggle-scroll-btn');
        const scrollCtrlEl = document.getElementById('mufy-scroll-ctrl');

        // 读取记住的状态
        const isScrollHidden = localStorage.getItem('mufy_scroll_hidden') === 'true';

        // 初始化状态
        if (isScrollHidden) {
            scrollCtrlEl.style.display = 'none';
            toggleScrollBtn.style.color = '#444'; // 隐藏时颜色变暗
        } else {
            toggleScrollBtn.style.color = 'var(--text-sub)'; // 正常颜色
        }

        // 点击切换
        toggleScrollBtn.addEventListener('click', () => {
            const currentlyHidden = scrollCtrlEl.style.display === 'none';
            if (currentlyHidden) {
                scrollCtrlEl.style.display = 'flex';
                toggleScrollBtn.style.color = 'var(--text-sub)';
                localStorage.setItem('mufy_scroll_hidden', 'false');
            } else {
                scrollCtrlEl.style.display = 'none';
                toggleScrollBtn.style.color = '#444';
                localStorage.setItem('mufy_scroll_hidden', 'true');
            }
        });
               // ================= 拖拽面板逻辑（鼠标分离无敌版） =================
        let isDragging = false;
        let startX, startY, initialLeft, initialTop;
        const headerEl = modal.querySelector('.mufy-header');

        // 防止选中文字，提升拖拽手感
        headerEl.style.cursor = 'move';
        headerEl.style.userSelect = 'none';

        headerEl.onmousedown = function(e) {
            // 如果点的是按钮（关闭、截图等），不触发拖拽
            if (e.target.closest('button')) return;

            e.preventDefault(); // ★ 阻止默认的文本选中和原生拖拽行为
            isDragging = true;

            const rect = modal.getBoundingClientRect();
            initialLeft = rect.left;
            initialTop = rect.top;
            startX = e.clientX;
            startY = e.clientY;

            // 干掉居中用的 transform，改成绝对定位
            modal.style.transform = 'none';
            modal.style.left = `${initialLeft}px`;
            modal.style.top = `${initialTop}px`;
            modal.style.margin = '0';

            // 视觉反馈：加深阴影
            modal.style.boxShadow = '0 30px 80px rgba(0,0,0,1)';
        };

        // 监听整个文档的鼠标移动
        document.addEventListener('mousemove', function(e) {
            if (!isDragging) return;

            // 计算移动距离
            const dx = e.clientX - startX;
            const dy = e.clientY - startY;

            let newLeft = initialLeft + dx;
            let newTop = initialTop + dy;

            // 防止拖出屏幕外（留出部分面板在视野内）
            const w = window.innerWidth;
            const h = window.innerHeight;

            if (newLeft < -modal.offsetWidth + 100) newLeft = -modal.offsetWidth + 100;
            if (newLeft > w - 100) newLeft = w - 100;
            if (newTop < 0) newTop = 0;
            if (newTop > h - 50) newTop = h - 50;

            modal.style.left = `${newLeft}px`;
            modal.style.top = `${newTop}px`;

            e.preventDefault(); // ★ 持续阻止默认拖拽
        });

        // 松开鼠标结束拖拽
        document.addEventListener('mouseup', function() {
            if (isDragging) {
                isDragging = false;
                modal.style.boxShadow = '0 20px 60px rgba(0,0,0,.9)';
            }
        });

        // ================= 备份/恢复逻辑 =================
        const exportBtn = modal.querySelector('#mufy-ar-export');
        const importBtn = modal.querySelector('#mufy-ar-import');
        const importFile = modal.querySelector('#mufy-ar-import-file');

        exportBtn.addEventListener('click', () => {
           const keysToExport = [CACHE_DATA_KEY, MASK_LIBRARY_KEY, ACCOUNTS_KEY, TAG_RULES_KEY];
            const data = {};
            keysToExport.forEach(k => {
                const val = localStorage.getItem(k);
                if (val) data[k] = val;
            });

            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `mufy_backup_${new Date().toLocaleDateString('zh-CN').replace(/\//g, '-')}.json`;
            a.click();
            URL.revokeObjectURL(url);
            setStatus('数据已导出下载');
        });

        importBtn.addEventListener('click', () => importFile.click());
        importFile.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (event) => {
                try {
                    const data = JSON.parse(event.target.result);
                    let count = 0;
                    Object.keys(data).forEach(k => {
                        if (typeof data[k] === 'string') {
                            localStorage.setItem(k, data[k]);
                            count++;
                        }
                    });
                    alert(' 数据恢复成功！即将刷新页面应用新数据。');
                    window.location.reload();
                } catch (err) {
                    alert(' 恢复失败，文件格式不正确');
                }
            };
            reader.readAsText(file);
            importFile.value = '';
        });

        const setStatus = (text, isError = false) => {
            statusEl.textContent = text;
            if (isError) statusEl.classList.remove('success');
            else statusEl.classList.add('success');
        };

                       function renderActiveTab() {
            if (state.activeTab === 'collection') renderCollection(contentEl);
            else if (state.activeTab === 'masklib') renderMaskLibrary(contentEl);
            else if (state.activeTab === 'harvest') renderHarvestTab(contentEl);
            else if (state.activeTab === 'accounts') renderAccountsTab(contentEl, setStatus);
           else if (state.activeTab === 'memo') renderMemoTab(contentEl);
else if (state.activeTab === 'archive') renderArchiveTab(contentEl); // 👈 加上这行
            else renderContent(contentEl);
        }
        function openModal() {
            modal.style.setProperty('display', 'flex', 'important');
            modal.style.setProperty('visibility', 'visible', 'important');
            modal.style.setProperty('pointer-events', 'auto', 'important');
            if (!state.isScanning) {
                const cacheTime = loadCache();
                if (cacheTime) {
                    setStatus(`已加载本地缓存 (${cacheTime})`);
                    renderActiveTab();
                } else if (state.activeTab === 'masklib') {
                    setStatus('面具库就绪');
                    renderActiveTab();
                } else setStatus('暂无数据，请点击扫描。');
            }
        }
        function closeModal() {
            modal.style.setProperty('display', 'none', 'important');
            modal.style.setProperty('pointer-events', 'none', 'important');
            modal.classList.remove('mufy-screenshot-mode');
        }
        // ================= 悬浮球拖拽与点击分离逻辑 =================
        // 1. 读取上次保存的位置
        try {
            const savedPos = JSON.parse(localStorage.getItem('mufy_btn_pos') || 'null');
            if (savedPos && typeof savedPos.left === 'number') {
                btn.style.left = `${savedPos.left}px`;
                btn.style.top = `${savedPos.top}px`;
                btn.style.right = 'auto';
                btn.style.bottom = 'auto';
            }
        } catch (e) {}

        let btnDragStartX, btnDragStartY, btnStartLeft, btnStartTop;
        let btnIsDragging = false;
        let btnMoved = false;

        // 2. 按下鼠标
        btn.addEventListener('pointerdown', (e) => {
            if (e.button !== 0) return; // 仅限左键

            e.preventDefault(); // 防止触发原生拖拽
            btnIsDragging = true;
            btnMoved = false;
            btnDragStartX = e.clientX;
            btnDragStartY = e.clientY;

            const rect = btn.getBoundingClientRect();
            btnStartLeft = rect.left;
            btnStartTop = rect.top;

            btn.setPointerCapture(e.pointerId); // 锁定指针
        });

        // 3. 移动鼠标
        btn.addEventListener('pointermove', (e) => {
            if (!btnIsDragging) return;

            const dx = e.clientX - btnDragStartX;
            const dy = e.clientY - btnDragStartY;

            // 只要移动超过 3px，就判定为“拖拽”而不是“点击”
            if (Math.abs(dx) > 3 || Math.abs(dy) > 3) {
                btnMoved = true;
                btn.style.right = 'auto';
                btn.style.bottom = 'auto';

                // 防止拖出屏幕外（留出 10px 边距）
                let newLeft = btnStartLeft + dx;
                let newTop = btnStartTop + dy;
                const maxLeft = window.innerWidth - btn.offsetWidth - 10;
                const maxTop = window.innerHeight - btn.offsetHeight - 10;

                newLeft = Math.max(10, Math.min(newLeft, maxLeft));
                newTop = Math.max(10, Math.min(newTop, maxTop));

                btn.style.left = `${newLeft}px`;
                btn.style.top = `${newTop}px`;
            }
        });

        // 4. 松开鼠标
        btn.addEventListener('pointerup', (e) => {
            if (!btnIsDragging) return;
            btnIsDragging = false;
            btn.releasePointerCapture(e.pointerId);

            if (btnMoved) {
                // 如果发生拖拽，保存最后的位置，且不打开面板
                const rect = btn.getBoundingClientRect();
                localStorage.setItem('mufy_btn_pos', JSON.stringify({ left: rect.left, top: rect.top }));
            } else {
                // 如果没移动，说明是“纯点击”，打开面板
                openModal();
            }
        });

        // 5. 处理拖拽取消的情况（比如鼠标划出了浏览器）
        btn.addEventListener('pointercancel', (e) => {
            if (!btnIsDragging) return;
            btnIsDragging = false;
            btn.releasePointerCapture(e.pointerId);
        });
        modal.querySelector('#mufy-ar-close').addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); closeModal(); }, true);
        screenshotBtn.addEventListener('click', () => modal.classList.add('mufy-screenshot-mode'));
        exitScreenshotBtn.addEventListener('click', () => modal.classList.remove('mufy-screenshot-mode'));

        // ================= 回顶回底点击事件 =================
        // 查找当前页面真正的滚动容器（有些网页滚动的是 body，有些是内部某个 div）
        function getScrollTargets() {
            const targets = [window, document.documentElement, document.body];
            // 兜底：找出页面上所有可滚动的 div 容器
            const allDivs = document.querySelectorAll('div, main, section');
            for (let i = 0; i < allDivs.length; i++) {
                const div = allDivs[i];
                if (div.scrollHeight > div.clientHeight && div.clientHeight > window.innerHeight * 0.5) {
                    targets.push(div);
                }
            }
            return targets;
        }

        const scrollTopBtn = document.getElementById('mufy-scroll-top');
        const scrollBottomBtn = document.getElementById('mufy-scroll-bottom');

        scrollTopBtn.addEventListener('click', () => {
            getScrollTargets().forEach(el => {
                try { el.scrollTo({ top: 0, behavior: 'smooth' }); } catch(e) {}
            });
        });

               scrollBottomBtn.addEventListener('click', () => {
            getScrollTargets().forEach(el => {
                try {
                    const maxScroll = el.scrollHeight || 9999999;
                    el.scrollTo({ top: maxScroll, behavior: 'smooth' });
                } catch(e) {}
            });
        });

        function switchTab(tab) {
    state.activeTab = tab;
    tabRole.className = `mufy-tab ${tab === 'role' ? 'active' : ''}`;
    tabAuthor.className = `mufy-tab ${tab === 'author' ? 'active' : ''}`;
    tabCollection.className = `mufy-tab ${tab === 'collection' ? 'active' : ''}`;
    tabMaskLib.className = `mufy-tab ${tab === 'masklib' ? 'active' : ''}`;
    tabHarvest.className = `mufy-tab ${tab === 'harvest' ? 'active' : ''}`;
    tabAccounts.className = `mufy-tab ${tab === 'accounts' ? 'active' : ''}`;
    tabMemo.className = `mufy-tab ${tab === 'memo' ? 'active' : ''}`;
    tabArchive.className = `mufy-tab ${tab === 'archive' ? 'active' : ''}`;

    // ★ 新增：把当前激活的 Tab 滚进视野
    const activeBtn = modal.querySelector(`.mufy-tab.active`);
    if (activeBtn) {
        activeBtn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    }

    renderActiveTab();
}

        tabRole.addEventListener('click', () => switchTab('role'));
        tabAuthor.addEventListener('click', () => switchTab('author'));
        tabCollection.addEventListener('click', () => switchTab('collection'));
        tabMaskLib.addEventListener('click', () => switchTab('masklib'));
        tabHarvest.addEventListener('click', () => switchTab('harvest'));
        tabAccounts.addEventListener('click', () => switchTab('accounts'));
        tabMemo.addEventListener('click', () => switchTab('memo'));
tabArchive.addEventListener('click', () => switchTab('archive')); //  加上这行


searchInput.addEventListener('input', e => {
    state.searchQuery = e.target.value.trim();
    state.searchParsed = parseSearchToken(state.searchQuery);
    if (state.isScanning) return;
    if (['role', 'author'].includes(state.activeTab)) {
        renderContent(contentEl);
    } else if (state.activeTab === 'collection') {
        renderCollection(contentEl);
    } else if (state.activeTab === 'masklib') {
        renderMaskLibrary(contentEl);
    }
});
        contentEl.addEventListener('click', async (e) => {
const modeBtn = e.target.closest('[data-mode]');
if (modeBtn) {
    e.preventDefault();
    state.collectionMode = modeBtn.getAttribute('data-mode');
    renderCollection(contentEl);
    return;
}
if (e.target.id === 'mufy-organize-tag') {
    e.preventDefault();
    const raw = contentEl.querySelector('#mufy-tag-rules')?.value || '';
    localStorage.setItem(TAG_RULES_KEY, raw);
    if (!state.roles.length) { setStatus('请先扫描', true); return; }
    if (!parseTagRules(raw).length) { setStatus('请填写至少一条有效规则（夹名 = 标签1, 标签2）', true); return; }
    if (!confirm('按标签整理会创建/复用标签夹。\n\n⚠️ 已在作者夹里的角色可能加不进新夹（接口限制），旧夹不会自动清空。\n建议先点「清空旧夹」。继续？')) return;
    e.target.disabled = true;
    try { await organizeByTag(setStatus); renderCollection(contentEl); }
    finally { e.target.disabled = false; }
    return;
}
if (e.target.id === 'mufy-clear-folders') {
    e.preventDefault();
    showClearFoldersDialog(() => renderCollection(contentEl));
    return;
}
            if (e.target.id === 'mufy-organize-followed') {
                e.preventDefault();
                if (!state.roles.length) { setStatus('请先扫描', true); return; }
                const followed = state.roles.filter(r => r.isFollowed);
                if (!followed.length) { setStatus('还没有已收藏的角色', true); return; }
                const groups = new Set(followed.map(r => r.authorId || 'unknown'));
                if (!confirm(`将为 ${groups.size} 个作者创建/更新收藏夹，归入 ${followed.length} 个已收藏角色。\n\n注意：会在 Mufy 里创建同名收藏夹（如果已有则复用）。\n继续？`)) return;
                e.target.disabled = true;
                try { await organizeByAuthor(setStatus, true); renderCollection(contentEl); }
                finally { e.target.disabled = false; }
                return;
            }
            if (e.target.id === 'mufy-organize-all') {
                e.preventDefault();
                if (!state.roles.length) { setStatus('请先扫描', true); return; }
                const unfollowed = state.roles.filter(r => !r.isFollowed);
                const groups = new Set(state.roles.map(r => r.authorId || 'unknown'));
                if (!confirm(`将先自动收藏 ${unfollowed.length} 个未收藏角色，然后为 ${groups.size} 个作者创建/更新收藏夹。\n\n请求较多，可能耗时几分钟，中途别关页面。\n继续？`)) return;
                e.target.disabled = true;
                try { await organizeByAuthor(setStatus, false); renderCollection(contentEl); }
                finally { e.target.disabled = false; }
                return;
            }
            if (e.target.id === 'mufy-view-folders') { e.preventDefault(); showFoldersDialog(); return; }
            if (e.target.id === 'mufy-clean-dead') {
                e.preventDefault();
                if (!state.roles.length) { setStatus('请先扫描', true); return; }

                // 筛选出所有“未遂（你两见过但没法聊了）”和“作者未知失效”的卡
                const deadRoles = state.roles.filter(r =>
                    (r.isExpired && r.rounds === 0) ||
                    (r.authorId === 'unknown')
                );

                if (deadRoles.length === 0) {
                    alert('太棒了，当前数据中没有需要清理的失效死卡！');
                    return;
                }

                if (!confirm(`检测到 ${deadRoles.length} 张死卡（包括已失效、作者未知），是否一键取消收藏并从本地列表移除？\n\n注意：这不会删除角色本身，只是帮你清理收藏夹和本地数据。`)) return;

                e.target.disabled = true;
                e.target.textContent = `清理中 0/${deadRoles.length}`;
                let success = 0;

                for (let i = 0; i < deadRoles.length; i++) {
                    const r = deadRoles[i];
                    e.target.textContent = `清理中 ${i+1}/${deadRoles.length}`;
                    // 只有在收藏状态时才调接口
                    if (r.isFollowed) {
                        const res = await followCharacter(r.characterId, false);
                        if (res.ok) {
                            r.isFollowed = false;
                            success++;
                        }
                    } else {
                        success++; // 本来就没收藏，直接算清理成功
                    }
                    await sleep(400);
                }

                // 从 state.roles 里物理移除这些卡
                state.roles = state.roles.filter(r => !deadRoles.includes(r));
                saveCache();
                addCollectionLog(`清理了 ${deadRoles.length} 张死卡`);

                alert(` 清理完成！成功处理了 ${success} 张卡。`);
                renderCollection(contentEl);
                return;
            }

            const filterBtn = e.target.closest('.mufy-filter-btn');
            if (filterBtn) { e.preventDefault(); state.collectionFilter = filterBtn.getAttribute('data-filter'); renderCollection(contentEl); return; }
            const maskBtn = e.target.closest('.mufy-mask-btn');
            if (maskBtn) { e.preventDefault(); showMaskPicker(maskBtn.getAttribute('data-cid'), maskBtn.getAttribute('data-name'), () => renderCollection(contentEl)); return; }
            const oneBtn = e.target.closest('.mufy-follow-one');
            if (oneBtn) {
                e.preventDefault();
                const cid = oneBtn.getAttribute('data-cid');
                const wasFollowed = oneBtn.getAttribute('data-followed') === 'true';
                const role = state.roles.find(r => isSameId(r.characterId, cid));
                if (!role) return;
                oneBtn.disabled = true; oneBtn.textContent = '...';
                const res = await followCharacter(cid, !wasFollowed);
                if (res.ok) { role.isFollowed = !wasFollowed; addCollectionLog(`${role.isFollowed ? '收藏' : '取消收藏'}了「${role.name}」`); saveCache(); }
                else { setStatus('收藏失败：' + (res.error || '接口异常'), true); console.error('[收藏失败]', res.raw); }
                renderCollection(contentEl);
                return;
            }
            const allBtn = e.target.closest('.mufy-follow-all');
            if (allBtn) {
                e.preventDefault();
                const authorId = allBtn.getAttribute('data-author');
                const targets = state.roles.filter(r => (r.authorId || 'unknown') === authorId && !r.isFollowed);
                if (!targets.length) return;
                if (!confirm(`确定收藏该作者下 ${targets.length} 个未收藏角色？`)) return;
                allBtn.disabled = true;
                const authorName = targets[0]?.authorName || '未知作者';
                const added = [], failed = [];
                for (let i = 0; i < targets.length; i++) {
                    allBtn.textContent = `收藏中 ${i + 1}/${targets.length}`;
                    const r = targets[i];
                    const res = await followCharacter(r.characterId, true);
                    if (res.ok) { r.isFollowed = true; added.push(r.name); }
                    else failed.push(r.name);
                    await sleep(500);
                }
                if (added.length) {
                    addCollectionLog(`一键收藏了作者「${authorName}」下的 ${added.length} 个角色${failed.length ? `（${failed.length} 个失败）` : ''}`);
                    saveCache();
                    setStatus(`已收藏 ${added.length} 个${failed.length ? `，失败 ${failed.length} 个` : ''}`, false);
                } else setStatus('一个都没收藏成功', true);
                renderCollection(contentEl);
                return;
            }
            const link = e.target.closest('a');
            if (link && state.isScanning) { e.preventDefault(); e.stopPropagation(); return; }
            const toggleBtn = e.target.closest('.mufy-author-toggle');
            if (toggleBtn) {
                const id = toggleBtn.getAttribute('data-id');
                if (state.expandedAuthors.has(id)) state.expandedAuthors.delete(id);
                else state.expandedAuthors.add(id);
                renderContent(contentEl);
                return;
            }

            // 单角色重扫事件
            const refreshBtn = e.target.closest('.mufy-refresh-btn');
            if (refreshBtn) {
                e.preventDefault();
                const cid = refreshBtn.getAttribute('data-cid');
                const role = state.roles.find(r => r.characterId === cid);
                if (!role) return;

                role.isScanning = true;
                renderContent(contentEl);

                const myId = state.myUserId || await getMyUserId();
                const result = await fetchMyRoundsFromComments(cid, myId);
                role.rounds = result.rounds;
                role.hasCommented = result.hasCommented;
                if (result.isExpired) role.isExpired = true;
                role.isScanning = false;
                role.hasScanned = true;
                saveCache();
                renderContent(contentEl);
                return;
            }
        });

        clearBtn.addEventListener('click', () => {
            if(confirm('确定要清空本地缓存和账号记忆吗？\n（面具库不受影响）')) {
                localStorage.removeItem(CACHE_DATA_KEY);
                localStorage.removeItem(STORAGE_MY_ID_KEY);
                state.roles = []; state.authors = []; state.myUserId = '';
                state.expandedAuthors.clear(); state.collectionLog = [];
                state.maskBindings = {}; state.collectionFilter = 'all'; state.folderLog = [];
                masksCache = null; masksCacheTime = 0;
                renderActiveTab();
                setStatus('缓存已清空');
            }
        });

        idSaveBtn.addEventListener('click', () => {
            const manualId = idInput.value.trim();
            if (!manualId) return;
            localStorage.setItem(STORAGE_MY_ID_KEY, manualId);
            state.myUserId = manualId;
            manualWrap.style.display = 'none';
            alert('账号 ID 已保存。');
        });

        singleBtn.addEventListener('click', async () => {
            const rawInput = singleInput.value.trim();
            if (!rawInput) return;
            singleBtn.disabled = true; singleBtn.textContent = '查询中...';
            singleResultEl.style.display = 'block';
            singleResultEl.innerHTML = '<span style="color:#666;">正在解析链接...</span>';
            try {
                const uuidRegex = /[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i;
                let targetId = '';
                const match = rawInput.match(uuidRegex);
                if (match) targetId = match[0];
                else {
                    try {
                        const urlObj = new URL(rawInput);
                        const sp = urlObj.searchParams;
                        if (sp.has('roleId')) targetId = sp.get('roleId');
                        else if (sp.has('id')) targetId = sp.get('id');
                        else if (sp.has('shareCode')) {
                            const shareCode = sp.get('shareCode');
                            singleResultEl.innerHTML = '<span style="color:#666;">正在解析分享码...</span>';
                            const tryApis = [`${API_BASE}/api/characters/get?shareCode=${shareCode}`, `${API_BASE}/api/characters/share/info?shareCode=${shareCode}`, `${API_BASE}/api/share/info?shareCode=${shareCode}`];
                            for (const api of tryApis) {
                                try {
                                    const res = await mufyGet(api);
                                    if (res?.code === 200 && res.data) {
                                        const d = res.data.data || res.data;
                                        const cid = d.id || d.characterId;
                                        if (cid) { targetId = cid; break; }
                                    }
                                } catch(e) {}
                            }
                            if (!targetId) throw new Error('无法解析该分享码。');
                        }
                    } catch(e) { if (e.message.includes('无法解析')) throw e; }
                }
                if (!targetId) throw new Error('无效的 ID 或链接。');
                const myId = state.myUserId || await getMyUserId();
                if (!myId) throw new Error('缺失 UserID，请先点击全量扫描。');
                let charName = '未知角色', isExpired = false;
                const cachedRole = state.roles.find(r => isSameId(r.characterId, targetId));
                if (cachedRole) charName = cachedRole.name;
                else {
                    try {
                        const rRes = await mufyGet(`${API_BASE}/api/characters/get?id=${encodeURIComponent(targetId)}`);
                        if (rRes.code === 200) {
                            const d = rRes.data?.data || rRes.data || rRes;
                            charName = d.name || d.characterName || d.title || '未知角色';
                        } else if (rRes.error === 'share_link_expired') isExpired = true;
                    } catch (e) { if (e.isExpired) isExpired = true; }
                }
                singleResultEl.innerHTML = '<span style="color:#666;">正在查询轮数...</span>';
                const result = await fetchMyRoundsFromComments(targetId, myId);
                let resultHtml = '';
                if (result.rounds > 0) {
                    resultHtml = `<div style="font-size:13px;color:#888;margin-bottom:8px;">${esc(charName)} ${result.isExpired ? '<span style="color:#ff5252">(已失效)</span>' : ''}</div><div style="font-size:24px;font-weight:600;color:#fff;font-family:monospace;">${result.rounds} <span style="font-size:12px;color:#666;font-family:sans-serif;font-weight:normal;">轮</span></div>`;
                } else if (result.hasCommented) resultHtml = `<div style="color:#888;">曾评论过，但接口未返回具体轮数。</div>`;
                else if (result.isExpired) resultHtml = `<div style="color:#ff5252;">你两见过，没嫖过，你也嫖不了了。</div>`;
                else resultHtml = `<div style="color:#666;">未找到该角色下的评论记录。</div>`;
                singleResultEl.innerHTML = resultHtml;
            } catch (err) {
                singleResultEl.innerHTML = `<span style="color:#888;">错误：${err.message}</span>`;
            } finally {
                singleBtn.disabled = false; singleBtn.textContent = '查询';
            }
        });

        scanBtn.addEventListener('click', async () => {
            if (state.loading) return;
            state.loading = true; state.isScanning = true;
            state.expandedAuthors.clear();
            scanBtn.disabled = true; contentEl.innerHTML = '';
            try {
                setStatus('正在识别身份...');
                state.myUserId = await getMyUserId(setStatus);
                if (!state.myUserId) { manualWrap.style.display = 'block'; throw new Error('自动获取 ID 失败，请手动填入。'); }
                setStatus('正在获取角色列表...');
                const roles = await fetchAllCharacters(setStatus);
                if (!roles.length) throw new Error("未找到任何角色。");
                setStatus('正在补全作者信息并检查存活状态...');
                const missing = roles.filter(r => !r.authorId);
                if (missing.length > 0) {
                    for (let i = 0; i < missing.length; i += 3) {
                        const batch = missing.slice(i, i + 3);
                        await Promise.all(batch.map(async (role) => {
                            try {
                                const res = await mufyGet(`${API_BASE}/api/characters/get?id=${encodeURIComponent(role.characterId)}`);
                                if (res.code === 200 && res.data) {
                                    const d = res.data?.data || res.data || res;
                                    const authorObj = d.author || d.creator || d.user || d.character?.author || {};
                                    const aId = pick(d, 'authorId', 'creatorId') || pick(authorObj, 'id', 'userId');
                                    if (aId) { role.authorId = String(aId); role.authorName = pick(d, 'authorName') || pick(authorObj, 'username', 'name', 'nickname') || ''; }
                                }
                            } catch(e) { if (e.isExpired) role.isExpired = true; }
                        }));
                        await sleep(100);
                    }
                }
                state.roles = roles;
                const initialAuthors = new Map();
                roles.forEach(r => {
                    const aId = r.authorId || 'unknown';
                    if (!initialAuthors.has(aId)) initialAuthors.set(aId, { id: aId, name: r.authorName || (aId === 'unknown' ? '未知/失效作者' : '未知作者'), avatarUrl: '', totalRounds: 0, cards: 0, level: 0, rolesCount: 0, hasScanned: false, isScanning: false });
                    initialAuthors.get(aId).rolesCount += 1;
                });
                state.authors = [...initialAuthors.values()];
                switchTab('role');
                setStatus('开始并发扫描角色和作者...');
                const rolesList = state.roles;
                const authorsList = state.authors;
                await Promise.all([
                    streamScanRoles(rolesList, state.myUserId,
                        (c, t) => setStatus(`正在扫描角色 (${c}/${t})...`),
                        () => { state.roles = state.isScanning ? rolesList : [...rolesList].sort((a, b) => b.rounds - a.rounds); if (state.activeTab !== 'collection' && state.activeTab !== 'masklib' && state.activeTab !== 'harvest') renderContent(contentEl); }),
                    streamScanAuthors(authorsList,
                        (c, t) => setStatus(`正在扫描作者 (${c}/${t})...`),
                        () => { state.authors = state.isScanning ? authorsList : [...authorsList].sort((a, b) => b.totalRounds - a.totalRounds); if (state.activeTab !== 'collection' && state.activeTab !== 'masklib' && state.activeTab !== 'harvest') renderContent(contentEl); })
                ]);
                state.isScanning = false;
                state.roles = [...rolesList].sort((a, b) => b.rounds - a.rounds);
                state.authors = [...authorsList].sort((a, b) => b.totalRounds - a.totalRounds);
                saveCache();
                setStatus('扫描完成，现在可以点进去看啦！');
                renderActiveTab();
            } catch (err) {
                setStatus('❌ ' + err.message, true);
            } finally {
                state.loading = false; state.isScanning = false;
                scanBtn.disabled = false; btn.disabled = false;
            }
        });

               state.accounts = getSavedAccounts(); // 👈 新增这一行
        loadCache();
        setTimeout(maybeAutoSwitchMask, 500);
    }

    (function installRouteWatch() {
        try {
            ['pushState', 'replaceState'].forEach(m => {
                const orig = history[m];
                if (!orig || orig.__mufyRouteHook) return;
                const wrapped = function(...args) {
                    const r = orig.apply(this, args);
                    setTimeout(maybeAutoSwitchMask, 300);
                    return r;
                };
                wrapped.__mufyRouteHook = true;
                history[m] = wrapped;
            });
            window.addEventListener('popstate', () => setTimeout(maybeAutoSwitchMask, 300));
        } catch (e) {}
    })();

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', mount, { once: true });
    } else {
        mount();
    }
})();
