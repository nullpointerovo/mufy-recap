          .mufy-collection-actions{display:flex;gap:6px;flex:none;align-items:center}
          .mufy-follow-btn{background:transparent;border:1px solid #333;color:#aaa;padding:4px 10px;border-radius:14px;font-size:11px;cursor:pointer;white-space:nowrap}
          .mufy-follow-btn:disabled{opacity:.4;cursor:not-allowed}
          .mufy-follow-all{background:#fff;color:#000;border:none}
          .mufy-mask-btn{background:transparent;border:1px solid #333;color:#888;padding:4px 8px;border-radius:14px;font-size:11px;cursor:pointer;white-space:nowrap;max-width:110px;overflow:hidden;text-overflow:ellipsis}
